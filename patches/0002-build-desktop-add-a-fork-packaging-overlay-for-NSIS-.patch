From a1d8370f40b94c2af9a8f8ec399e8d2d9a9f9faa Mon Sep 17 00:00:00 2001
From: FunnyAWM <1142978300@qq.com>
Date: Wed, 28 Oct 2026 15:39:07 +0800
Subject: [PATCH] build(desktop): add a fork packaging overlay for NSIS
 installers

Windows ships nsis + portable instead of msix-only; store builds keep msix,
since Partner Center accepts no other identity. The NSIS installer is
per-user, so no administrator prompt and the install tree stays out of
Program Files.

publish is nulled: base falls back to NousResearch/hermes-agent when
GITHUB_REPOSITORY is unset, so a configured feed would offer upstream
releases as updates and silently replace this fork.

Upstream electron-builder.config.cjs stays untouched. The release workflow
in .github/workflows/desktop-bundled-release.yml stages *.msix and would
break on a changed target, and every tag sync would conflict on it.

Note: scripts/run-electron-builder.mjs whitelists dmg/zip/msix/AppImage/deb/rpm
only, so nsis must be built through electron-builder directly with --config
electron-builder.fork.cjs.
---
 apps/desktop/electron-builder.fork.cjs | 42 ++++++++++++++++++++++++++
 1 file changed, 42 insertions(+)
 create mode 100644 apps/desktop/electron-builder.fork.cjs

diff --git a/apps/desktop/electron-builder.fork.cjs b/apps/desktop/electron-builder.fork.cjs
new file mode 100644
index 0000000000..7d342d0039
--- /dev/null
+++ b/apps/desktop/electron-builder.fork.cjs
@@ -0,0 +1,42 @@
+// Fork packaging overlay — Windows via NSIS/portable instead of MSIX.
+//
+// Kept as a separate file on purpose: `electron-builder.config.cjs` is upstream's
+// only build config and is consumed verbatim by the upstream release workflow
+// (.github/workflows/desktop-bundled-release.yml stages *.msix / *.msixbundle).
+// Editing it in place would conflict on every upstream tag sync. A new file that
+// upstream does not have can never conflict.
+//
+// Usage (bypassing scripts/run-electron-builder.mjs, see the note below):
+//   npm run build
+//   npx electron-builder --config electron-builder.fork.cjs --win nsis --x64
+//
+// @ts-check
+'use strict'
+
+const base = require('./electron-builder.config.cjs')
+const { store } = require('./product-identity.cjs')
+
+module.exports = {
+  ...base,
+
+  // Fork builds never publish and never check for updates. Base falls back to
+  // `NousResearch/hermes-agent` when GITHUB_REPOSITORY is unset
+  // (electron-builder.config.cjs:60) — leaving a feed configured would offer
+  // upstream releases as "updates" and silently replace this fork.
+  publish: null,
+
+  win: {
+    ...base.win,
+    // A store build must stay MSIX: Partner Center only accepts that identity.
+    // Everything else ships as a normal Electron installer.
+    target: store ? ['msix'] : ['nsis', 'portable']
+  },
+
+  nsis: {
+    // Per-user install: no administrator prompt, and the install tree stays out
+    // of Program Files. Application data lives in HERMES_HOME, not here, so an
+    // overwrite install never touches memories/ or notes/ (T-12's criterion).
+    oneClick: true,
+    perMachine: false
+  }
+}

