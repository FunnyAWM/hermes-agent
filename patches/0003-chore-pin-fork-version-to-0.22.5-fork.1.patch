From 812e0386d8dadc65840da2a2c8766d16808167a2 Mon Sep 17 00:00:00 2001
From: FunnyAWM <1142978300@qq.com>
Date: Wed, 28 Oct 2026 15:39:12 +0800
Subject: [PATCH] chore: pin fork version to 0.22.5-fork.1

Fork versions track the upstream base with a counter: 0.22.5-fork.1 means
"upstream 0.22.5, first fork build". A new upstream base resets the counter,
a rebuild on the same base increments it.

The two packages spell it differently on purpose. The desktop uses the SemVer
prerelease form (0.22.5-fork.1), which electron-builder and npm accept and
which survives into the artifact filename. Python uses the PEP 440 local
version form (0.22.5+fork1), because -fork.1 is not a valid PEP 440 version:
the separator only accepts a number for a post release.

Neither spelling belongs in scripts/releases/* or the update channel, whose
version grammar accepts only vX.Y.Z and the canary +canary.<stamp> form.
---
 apps/desktop/package.json | 2 +-
 pyproject.toml            | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/apps/desktop/package.json b/apps/desktop/package.json
index ecdbf0a532..cde8290cba 100644
--- a/apps/desktop/package.json
+++ b/apps/desktop/package.json
@@ -2,7 +2,7 @@
   "name": "hermes",
   "productName": "Hermes",
   "private": true,
-  "version": "0.0.0",
+  "version": "0.22.5-fork.1",
   "description": "Native desktop shell for Hermes Agent.",
   "author": "Nous Research",
   "repository": {
diff --git a/pyproject.toml b/pyproject.toml
index 3f1155f359..bb71447fc1 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -4,7 +4,7 @@
 
 [project]
 name = "hermes-agent"
-version = "0.0.0"
+version = "0.22.5+fork1"
 description = "The self-improving AI agent — creates skills from experience, improves them during use, and runs anywhere"
 readme = "README.md"
 # 3.14 is the newest python we know we have wheels for.

