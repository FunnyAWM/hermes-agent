From b8e1fa9a3c788beba6c1e3ca4d5d2893e618987e Mon Sep 17 00:00:00 2001
From: FunnyAWM <1142978300@qq.com>
Date: Tue, 3 Nov 2026 10:33:47 +0800
Subject: [PATCH 03/48] fix(privacy): require opt-in for passive update checks

---
 hermes_cli/config_defaults.py                 | 12 +++----
 hermes_cli/source_check.py                    |  6 +++-
 .../hermes_cli/test_banner_release_channel.py |  1 +
 .../hermes_cli/test_passive_update_opt_out.py | 34 +++++++++++++++----
 4 files changed, 40 insertions(+), 13 deletions(-)

diff --git a/hermes_cli/config_defaults.py b/hermes_cli/config_defaults.py
index 426b5a9f9c..32d1cbd30c 100644
--- a/hermes_cli/config_defaults.py
+++ b/hermes_cli/config_defaults.py
@@ -1706,10 +1706,10 @@ DEFAULT_CONFIG = {
         # skipped with the reason "load timed out" and the rest keep loading; the stuck worker thread is
         # abandoned. 0 = no deadline (load inline). Max 600.
         "load_timeout_seconds": 10,
-        # Read-only plugin update-check cadence, hours (gateway tick; 0 disables). Applying stays
-        # explicit: `hermes plugins update <name>`, or auto_apply below (git-class plugins only,
-        # scan-gated by that same pipeline).
-        "auto_update_check_hours": 24,
+        # Read-only plugin update-check cadence, hours (gateway tick; 0 disables).
+        # Fork policy (PRD §8.1 隐 02): off unless the user opts in; applying
+        # stays explicit (`hermes plugins update <name>` / `check-updates`).
+        "auto_update_check_hours": 0,
         # Opt-in unattended apply for the cadence check. Git-row plugins ONLY; every apply runs the
         # same security scan / consent pipeline as the manual update command.
         "auto_apply": False,
@@ -2337,8 +2337,8 @@ DEFAULT_CONFIG = {
     },
 
     "updates": {
-        # Passive version/banner checks only; explicit `hermes update --check` remains enabled.
-        "check": True,
+        # Fork privacy (PRD §8.1): passive checks opt in; explicit `hermes update --check` stays enabled.
+        "check": False,
         # Pre-update backup. quick = snapshot small critical state (pairing JSONs, cron jobs,
         # config.yaml, .env, auth.json, profile DBs) into <HERMES_HOME>/state-snapshots/, skipping
         # files >1 GiB; restore via ``/snapshot``. full = quick PLUS a ``hermes backup`` zip in
diff --git a/hermes_cli/source_check.py b/hermes_cli/source_check.py
index 6d2f267d5f..0b8dbccae5 100644
--- a/hermes_cli/source_check.py
+++ b/hermes_cli/source_check.py
@@ -534,7 +534,11 @@ def check_for_updates(*, install_root: Path | None = None, home: Path | None = N
     if unsupported:
         return {**result, **unsupported}
     config = require_readable_config_before_write(home / "config.yaml")
-    if passive and (config.get("updates") or {}).get("check") is False:
+    # Passive (banner) checks are opt-in for this fork: PRD §8.1 隐 02 allows one
+    # outbound link, the model endpoint. Absence of the key means off, so a
+    # fresh install never phones GitHub; `updates.check: true` restores the
+    # upstream behaviour and `hermes update --check` (not passive) is untouched.
+    if passive and (config.get("updates") or {}).get("check") is not True:
         return {**result, "reason": "disabled"}
     channel = resolve_update_channel(config, root) if channel is None else validate_name(channel)
     forward_only = rides_default_channel(channel_record(config, root), channel, root)
diff --git a/tests/hermes_cli/test_banner_release_channel.py b/tests/hermes_cli/test_banner_release_channel.py
index b2ad34dec5..27a08d923e 100644
--- a/tests/hermes_cli/test_banner_release_channel.py
+++ b/tests/hermes_cli/test_banner_release_channel.py
@@ -25,6 +25,7 @@ def test_release_channel_never_compares_main_or_reuses_main_cache(tmp_path, monk
     target = "b" * 40
     monkeypatch.setattr(source_check, "_git_stdout", lambda args, **kw: head if args == ["rev-parse", "HEAD"] else "https://github.com/example/fork.git")
     (get_hermes_home() / "config.yaml").write_text(json.dumps({
+        "updates": {"check": True},
         "update": {"installs": {install_id(root): {"path": str(root), "channel": channel}}}
     }))
     (get_hermes_home() / ".update_check").write_text(json.dumps({
diff --git a/tests/hermes_cli/test_passive_update_opt_out.py b/tests/hermes_cli/test_passive_update_opt_out.py
index 9444956589..fa5e1497b5 100644
--- a/tests/hermes_cli/test_passive_update_opt_out.py
+++ b/tests/hermes_cli/test_passive_update_opt_out.py
@@ -4,18 +4,40 @@ import subprocess
 from hermes_constants import get_hermes_home
 
 
-def test_explicit_check_fetches_local_origin_despite_passive_opt_out(tmp_path, monkeypatch, capsys):
-    from hermes_cli import main
-    from hermes_cli.update_cmd import _cmd_update_check
-
+def _checkout_with_ahead_origin(tmp_path):
     remote = tmp_path / "remote"
     local = tmp_path / "checkout"
+
     def git(*args):
         return subprocess.run(["git", *map(str, args)], check=True, capture_output=True, text=True)
+
     git("init", "-b", "main", remote)
-    git("-C", remote, "-c", "user.name=Fixture", "-c", "user.email=fixture@example.invalid", "commit", "--allow-empty", "-m", "initial")
+    git("-C", remote, "-c", "user.name=Fixture", "-c", "user.email=fixture@example.invalid",
+        "commit", "--allow-empty", "-m", "initial")
     git("clone", remote, local)
-    git("-C", remote, "-c", "user.name=Fixture", "-c", "user.email=fixture@example.invalid", "commit", "--allow-empty", "-m", "next")
+    git("-C", remote, "-c", "user.name=Fixture", "-c", "user.email=fixture@example.invalid",
+        "commit", "--allow-empty", "-m", "next")
+    return local
+
+
+def test_passive_check_is_disabled_unless_the_user_opts_in(tmp_path):
+    """PRD §8.1 隐 02: a fresh PC profile's only outbound link is the model endpoint."""
+    from hermes_cli.source_check import check_for_updates
+
+    local = _checkout_with_ahead_origin(tmp_path)
+    home = get_hermes_home()
+    assert check_for_updates(passive=True, install_root=local, home=home)["reason"] == "disabled"
+    # The explicit path still works and still sees the extra commit on origin.
+    status = check_for_updates(install_root=local, home=home, force=True)
+    assert status["updateAvailable"] is True
+    assert status["behind"] in (-1, 1)
+
+
+def test_explicit_check_fetches_local_origin_despite_passive_opt_out(tmp_path, monkeypatch, capsys):
+    from hermes_cli import main
+    from hermes_cli.update_cmd import _cmd_update_check
+
+    local = _checkout_with_ahead_origin(tmp_path)
     monkeypatch.setattr(main, "PROJECT_ROOT", local)
     (get_hermes_home() / "config.yaml").write_text("updates:\n  check: false\n", encoding="utf-8")
     _cmd_update_check()
