diff --git a/hermes_notes/store.py b/hermes_notes/store.py
new file mode 100644
index 0000000000..1dea2ae387
--- /dev/null
+++ b/hermes_notes/store.py
@@ -0,0 +1,111 @@
+"""Secure, profile-scoped Markdown note scanning and summary rendering."""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Final
+
+CATEGORY_DISPLAY_NAMES: Final[dict[str, str]] = {
+    "work": "工作",
+    "study": "学习",
+    "life": "生活",
+    "health": "健康",
+    "finance": "财务",
+    "people": "人际",
+    "other": "其他",
+}
+MAX_INDEX_ENTRIES: Final[int] = 64
+_MAX_SUMMARY_CHARS: Final[int] = 40
+_FRONT_MATTER_RE: Final[re.Pattern[str]] = re.compile(r"^---\s*\n(?P<body>.*?)(?:\n---\s*\n|\Z)", re.DOTALL)
+_FIELD_RE: Final[re.Pattern[str]] = re.compile(r"^(name|description|updated):\s*(.*?)\s*$", re.MULTILINE)
+
+
+@dataclass(frozen=True)
+class NoteEntry:
+    category: str
+    name: str
+    summary: str
+    path: Path
+    updated: str = ""
+
+    @property
+    def display_line(self) -> str:
+        return f"{CATEGORY_DISPLAY_NAMES[self.category]}/{self.name} — {self.summary}"
+
+
+class NotesStore:
+    """Read and validate notes beneath one Hermes home."""
+
+    def __init__(self, home: Path, *, max_entries: int = MAX_INDEX_ENTRIES) -> None:
+        self.home = home
+        self.root = home / "notes"
+        if max_entries <= 0:
+            raise ValueError("max_entries must be positive")
+        self.max_entries = max_entries
+
+    def validate_category(self, category: str) -> str:
+        if category not in CATEGORY_DISPLAY_NAMES:
+            allowed = ", ".join(CATEGORY_DISPLAY_NAMES)
+            raise ValueError(f"invalid note category {category!r}; choose one of: {allowed}")
+        return category
+
+    def note_path(self, category: str, topic: str) -> Path:
+        self.validate_category(category)
+        if not topic or Path(topic).name != topic or topic in {".", ".."}:
+            raise ValueError("note topic must be a single file name")
+        filename = topic if topic.endswith(".md") else f"{topic}.md"
+        return self.root / category / filename
+
+    def list_entries(self) -> list[NoteEntry]:
+        return self._scan()[1]
+
+    def omitted_count(self) -> int:
+        """Notes beyond the index cap — the PRD §7.4 rule is “截断必须明示,不静默丢弃”."""
+        total, capped = self._scan()
+        return len(total) - len(capped)
+
+    def _scan(self) -> tuple[list[NoteEntry], list[NoteEntry]]:
+        if not self.root.is_dir():
+            return [], []
+        entries: list[NoteEntry] = []
+        for path in sorted(self.root.rglob("*.md")):
+            if not path.is_file():
+                continue
+            try:
+                relative = path.relative_to(self.root)
+                category = relative.parts[0] if len(relative.parts) > 1 else "other"
+                if category not in CATEGORY_DISPLAY_NAMES:
+                    category = "other"
+                text = path.read_text(encoding="utf-8")
+            except (OSError, UnicodeError, ValueError):
+                continue
+            fields = self._front_matter_fields(text)
+            name = fields.get("name") or path.stem
+            summary = fields.get("description") or ""
+            summary = " ".join(summary.split())[:_MAX_SUMMARY_CHARS]
+            if not summary:
+                continue
+            entries.append(NoteEntry(category, name, summary, path, fields.get("updated", "")))
+        entries.sort(key=lambda entry: (entry.updated, entry.path.as_posix()), reverse=True)
+        return entries, entries[: self.max_entries]
+
+    def render_index(self) -> str:
+        entries = self.list_entries()
+        if not entries:
+            return ""
+        lines = ["NOTES INDEX (names and summaries only)"]
+        lines.extend(f"- {entry.display_line}" for entry in entries)
+        omitted = self.omitted_count()
+        if omitted > 0:
+            lines.append(f"(-{omitted} older notes beyond this index's {self.max_entries}-entry cap; "
+                         "list notes/<category>/ to read one)")
+        return "\n".join(lines)
+
+    @staticmethod
+    def _front_matter_fields(text: str) -> dict[str, str]:
+        match = _FRONT_MATTER_RE.match(text)
+        if not match:
+            return {}
+        return {key: value for key, value in _FIELD_RE.findall(match.group("body"))}
diff --git a/tests/agent/test_notes_prompt.py b/tests/agent/test_notes_prompt.py
new file mode 100644
index 0000000000..f1ed598c18
--- /dev/null
+++ b/tests/agent/test_notes_prompt.py
@@ -0,0 +1,106 @@
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import patch
+
+from agent.system_prompt import build_system_prompt_parts
+from hermes_notes import CATEGORY_DISPLAY_NAMES, MAX_INDEX_ENTRIES, NotesStore
+
+
+def test_notes_store_validates_categories_and_renders_summary_only(tmp_path: Path):
+    store = NotesStore(tmp_path)
+    assert set(CATEGORY_DISPLAY_NAMES) == {"work", "study", "life", "health", "finance", "people", "other"}
+    try:
+        store.note_path("invalid", "topic")
+    except ValueError as exc:
+        assert "work" in str(exc)
+    else:
+        raise AssertionError("invalid category was accepted")
+
+    note = store.note_path("work", "roadmap")
+    note.parent.mkdir(parents=True)
+    note.write_text(
+        "---\nname: 路线图\ndescription: 今年的发布计划\nupdated: 2026-10-20\n---\nSECRET BODY\n",
+        encoding="utf-8",
+    )
+    (tmp_path / "notes" / "unknown" ).mkdir()
+    (tmp_path / "notes" / "unknown" / "legacy.md").write_text(
+        "---\nname: 旧笔记\ndescription: 兼容目录\n---\nLEGACY BODY\n", encoding="utf-8"
+    )
+    rendered = store.render_index()
+    assert "工作/路线图 — 今年的发布计划" in rendered
+    assert "其他/旧笔记 — 兼容目录" in rendered
+    assert "SECRET BODY" not in rendered
+    assert "LEGACY BODY" not in rendered
+
+
+def test_notes_index_is_after_user_block(tmp_path: Path, monkeypatch):
+    note = tmp_path / "notes" / "study" / "book.md"
+    note.parent.mkdir(parents=True)
+    note.write_text("---\nname: 书\ndescription: 摘要\n---\n正文\n", encoding="utf-8")
+    memory = SimpleNamespace(format_for_system_prompt=lambda target: {"memory": "MEMORY", "user": "USER"}.get(target))
+    agent = SimpleNamespace(
+        load_soul_identity=False,
+        skip_context_files=True,
+        valid_tool_names=[],
+        _task_completion_guidance=False,
+        _tool_use_enforcement=False,
+        _environment_probe=False,
+        _kanban_worker_guidance="",
+        _memory_store=memory,
+        _memory_manager=None,
+        _memory_enabled=True,
+        _user_profile_enabled=True,
+        model="",
+        provider="",
+        platform="",
+        pass_session_id=False,
+        session_id="",
+        _emit_status=lambda *_args, **_kwargs: None,
+    )
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    with patch("agent.system_prompt._skills_prompt", return_value="SKILLS"):
+        volatile = build_system_prompt_parts(agent)["volatile"]
+    assert volatile.index("USER") < volatile.index("NOTES INDEX") < volatile.index("SKILLS")
+
+
+def test_notes_index_caps_entries(tmp_path: Path):
+    store = NotesStore(tmp_path)
+    for index in range(MAX_INDEX_ENTRIES + 3):
+        path = store.note_path("other", f"note-{index}")
+        path.parent.mkdir(parents=True, exist_ok=True)
+        path.write_text(f"---\nname: {index}\ndescription: item {index}\nupdated: 2026-10-{index % 28 + 1:02d}\n---\n", encoding="utf-8")
+    assert len(store.list_entries()) == MAX_INDEX_ENTRIES
+
+
+def test_notes_index_announces_omitted_entries(tmp_path: Path):
+    # PRD §7.4: 被截断的条数必须明示,不静默丢弃.
+    store = NotesStore(tmp_path)
+    assert store.render_index() == ""
+    assert store.omitted_count() == 0
+    for index in range(MAX_INDEX_ENTRIES + 2):
+        path = store.note_path("other", f"note-{index}")
+        path.parent.mkdir(parents=True, exist_ok=True)
+        path.write_text(f"---\nname: n{index}\ndescription: d{index}\nupdated: 2026-10-{index % 28 + 1:02d}\n---\n", encoding="utf-8")
+    rendered = store.render_index()
+    assert "(-2 older notes beyond this index's 64-entry cap" in rendered
+    assert len(store.list_entries()) == MAX_INDEX_ENTRIES
+    assert store.omitted_count() == 2
+
+
+def test_notes_index_keeps_newest_note_even_when_path_sorts_last(tmp_path: Path):
+    store = NotesStore(tmp_path, max_entries=1)
+    for topic, updated in (("aaa-new", "2026-11-03"), ("zzz-old", "2026-10-20")):
+        path = store.note_path("work", topic)
+        path.parent.mkdir(parents=True, exist_ok=True)
+        path.write_text(
+            f"---\nname: {topic}\ndescription: {topic} summary\nupdated: {updated}\n---\nBODY\n",
+            encoding="utf-8",
+        )
+
+    entries = store.list_entries()
+    assert [entry.name for entry in entries] == ["aaa-new"]
+    assert entries[0].updated == "2026-11-03"
+    rendered = store.render_index()
+    assert "aaa-new summary" in rendered
+    assert "zzz-old summary" not in rendered
+    assert "(-1 older notes" in rendered
