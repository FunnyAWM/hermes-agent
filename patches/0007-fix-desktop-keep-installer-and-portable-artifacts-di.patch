From 43f426b3952f394ae4c0f312453aabf55d67222b Mon Sep 17 00:00:00 2001
From: FunnyAWM <1142978300@qq.com>
Date: Tue, 3 Nov 2026 10:33:50 +0800
Subject: [PATCH] fix(desktop): keep installer and portable artifacts distinct

---
 apps/desktop/electron-builder.fork.cjs | 11 ++++++++++-
 package-lock.json                      |  2 +-
 2 files changed, 11 insertions(+), 2 deletions(-)

diff --git a/apps/desktop/electron-builder.fork.cjs b/apps/desktop/electron-builder.fork.cjs
index 7d342d0039..1c4c2f85de 100644
--- a/apps/desktop/electron-builder.fork.cjs
+++ b/apps/desktop/electron-builder.fork.cjs
@@ -14,7 +14,7 @@
 'use strict'
 
 const base = require('./electron-builder.config.cjs')
-const { store } = require('./product-identity.cjs')
+const { store, artifactNamePascal } = require('./product-identity.cjs')
 
 module.exports = {
   ...base,
@@ -33,10 +33,19 @@ module.exports = {
   },
 
   nsis: {
+    // NSIS and portable are one `win.target` list, and both would otherwise
+    // resolve the shared `${artifactName}` and write release/<same>.exe — the
+    // portable pass then silently overwrites the installer. Per-target names
+    // keep both artifacts, which is what §5.5 asks for.
+    artifactName: `${artifactNamePascal}-\${version}-\${os}-\${arch}-setup.\${ext}`,
     // Per-user install: no administrator prompt, and the install tree stays out
     // of Program Files. Application data lives in HERMES_HOME, not here, so an
     // overwrite install never touches memories/ or notes/ (T-12's criterion).
     oneClick: true,
     perMachine: false
+  },
+
+  portable: {
+    artifactName: `${artifactNamePascal}-\${version}-\${os}-\${arch}-portable.\${ext}`
   }
 }
diff --git a/package-lock.json b/package-lock.json
index 31db2ec070..5985657103 100644
--- a/package-lock.json
+++ b/package-lock.json
@@ -72,7 +72,7 @@
     },
     "apps/desktop": {
       "name": "hermes",
-      "version": "0.0.0",
+      "version": "0.22.5-fork.1",
       "dependencies": {
         "@assistant-ui/core": "0.2.23",
         "@assistant-ui/react": "0.14.29",

