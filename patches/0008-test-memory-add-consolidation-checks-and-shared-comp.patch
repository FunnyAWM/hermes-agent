diff --git a/scripts/capture_prompt_order.py b/scripts/capture_prompt_order.py
new file mode 100644
index 0000000000..060a08ec16
--- /dev/null
+++ b/scripts/capture_prompt_order.py
@@ -0,0 +1,143 @@
+"""Capture the real system-prompt section order for TODO.md T-03 / D4.
+
+Builds a minimal agent stub over a throwaway `HERMES_HOME`, calls the real
+`agent.system_prompt.build_system_prompt_parts`, and prints where each section
+actually lands. This is the reproducible protocol TODO.md §4.5 asks for.
+
+Usage::
+
+    .venv\\Scripts\\python.exe scripts\\capture_prompt_order.py
+
+Exit code 0 means all three T-03 criteria hold:
+
+1. no skills-index line appears before the MEMORY block;
+2. MEMORY -> USER -> notes index are three consecutive volatile sections;
+3. the SOUL section is the real SOUL.md, not the built-in default identity.
+"""
+from __future__ import annotations
+
+import os
+import sys
+import tempfile
+from pathlib import Path
+from types import SimpleNamespace
+
+REPO_ROOT = Path(__file__).resolve().parents[1]
+
+MEMORY_MARKER = "MEMORY (your personal notes)"
+USER_MARKER = "USER PROFILE"
+NOTES_MARKER = "NOTES INDEX"
+SKILLS_MARKER = "- stub-skill:"
+
+_failures: list[str] = []
+
+
+def check(label: str, condition: bool, detail: str = "") -> None:
+    if condition:
+        print(f"PASS {label}" + (f" :: {detail}" if detail else ""))
+        return
+    _failures.append(label)
+    print(f"FAIL {label}" + (f" :: {detail}" if detail else ""))
+
+
+def _stub_agent(memory_store):
+    return SimpleNamespace(
+        load_soul_identity=True,
+        skip_context_files=False,
+        valid_tool_names=["skills_list"],
+        _task_completion_guidance=False,
+        _tool_use_enforcement=False,
+        _environment_probe=False,
+        _kanban_worker_guidance="",
+        _memory_store=memory_store,
+        _memory_manager=None,
+        _memory_enabled=True,
+        _user_profile_enabled=True,
+        model="stub-model",
+        provider="stub-provider",
+        platform="cli",
+        pass_session_id=False,
+        session_id="t03-capture",
+        _emit_status=lambda *_a, **_k: None,
+    )
+
+
+def main() -> int:
+    sys.path.insert(0, str(REPO_ROOT))
+    with tempfile.TemporaryDirectory(prefix="hermes-t03-") as tmp:
+        home = Path(tmp) / "home"
+        project = Path(tmp) / "project"
+        (home / "memories").mkdir(parents=True)
+        project.mkdir()
+        os.environ["HERMES_HOME"] = str(home)
+
+        (home / "SOUL.md").write_text("SOUL_MARKER: stay terse, never pad.\n", encoding="utf-8")
+        (project / "AGENTS.md").write_text("AGENTS_MARKER: run the gates before you report.\n",
+                                           encoding="utf-8")
+        (home / "memories" / "MEMORY.md").write_text(
+            "Deploys: Fly.io, manual approval.\n§\nHost: forge", encoding="utf-8")
+        (home / "memories" / "USER.md").write_text("Prefers terse answers.", encoding="utf-8")
+        note = home / "notes" / "work" / "roadmap.md"
+        note.parent.mkdir(parents=True)
+        note.write_text("---\nname: 路线图\ndescription: 今年两次发布\nupdated: 2026-10-20\n---\nBODY\n",
+                        encoding="utf-8")
+
+        os.chdir(project)
+        import agent.system_prompt as sp
+        from tools.memory_tool_store import MemoryStore
+
+        # The real index needs the whole skills subsystem; a marker keeps the
+        # position observable without dragging in that dependency.
+        sp._skills_prompt = lambda agent: SKILLS_MARKER + " stub skill index"
+
+        store = MemoryStore()
+        store.load_from_disk()
+        agent = _stub_agent(store)
+        parts = sp.build_system_prompt_parts(agent)
+        prompt = "\n\n".join(parts[key] for key in ("stable", "context", "volatile"))
+
+        print("tiers: " + ", ".join(f"{k}={len(v):,} chars" for k, v in parts.items()))
+        markers = {
+            "SOUL": "SOUL_MARKER",
+            "AGENTS": "AGENTS_MARKER",
+            "MEMORY": MEMORY_MARKER,
+            "USER": USER_MARKER,
+            "NOTES": NOTES_MARKER,
+            "SKILLS": SKILLS_MARKER,
+        }
+        offsets = {name: prompt.find(marker) for name, marker in markers.items()}
+        print("\nsection offsets in the assembled prompt:")
+        for name, offset in offsets.items():
+            print(f"  {name:<7} {offset:>7}  {markers[name]}")
+        print("\nvolatile sections in order:")
+        for line in parts["volatile"].split("\n\n"):
+            print(f"  | {line.splitlines()[0][:90]}")
+
+        missing = [name for name, offset in offsets.items() if offset < 0]
+        check("every section is present", not missing, ", ".join(missing) or "all six")
+        check("SOUL comes before AGENTS", 0 <= offsets["SOUL"] < offsets["AGENTS"])
+        check("AGENTS comes before MEMORY", offsets["AGENTS"] < offsets["MEMORY"])
+        check("no skills-index line before MEMORY", offsets["SKILLS"] > offsets["MEMORY"],
+              f"skills at {offsets['SKILLS']}, memory at {offsets['MEMORY']}")
+        check("MEMORY -> USER -> NOTES are consecutive",
+              0 <= offsets["MEMORY"] < offsets["USER"] < offsets["NOTES"] < offsets["SKILLS"])
+        gap_between = prompt[offsets["MEMORY"]:offsets["NOTES"]]
+        check("nothing is injected between MEMORY and NOTES",
+              SKILLS_MARKER not in gap_between,
+              f"{len(gap_between)} chars between them")
+        check("SOUL.md really loaded (not the default identity)",
+              "SOUL_MARKER" in parts["stable"] and "You are Hermes Agent, built by Nous Research"
+              not in parts["stable"].split("SOUL_MARKER")[0])
+        print("\n--- volatile tier verbatim ---")
+        print(parts["volatile"])
+
+    print()
+    if _failures:
+        print(f"RESULT: {len(_failures)} criterion(s) failed -> {', '.join(_failures)}")
+        return 1
+    print("RESULT: all T-03 criteria hold")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/scripts/verify_consolidation_chain.py b/scripts/verify_consolidation_chain.py
new file mode 100644
index 0000000000..7b02a9fa32
--- /dev/null
+++ b/scripts/verify_consolidation_chain.py
@@ -0,0 +1,175 @@
+"""Reproducible PC-side check for TODO.md T-05 (PRD 记 06, data half).
+
+The live half of T-05 is a model conversation that runs to the context edge, summarises, extracts
+facts into ``notes/`` and opens a new session. That needs model credentials and a real session, so
+it stays blocked and is tracked separately. What this script *can* pin down is the part that would
+silently corrupt the hand-off: after a near-cap consolidation, do the two memory files stay within
+2200/1375, does the ``\\n§\\n`` counting rule survive, does the extracted note use PRD §7.3 front
+matter, and does a *fresh* store (the new session) render MEMORY → USER → notes index without the
+dropped entries?
+
+Usage (repo root, evidence venv)::
+
+    .venv\\Scripts\\python.exe scripts\\verify_consolidation_chain.py
+
+Exit code 0 means every check passed; the printed values are what ``evidence/t05.md`` quotes.
+"""
+from __future__ import annotations
+
+import os
+import sys
+import tempfile
+from pathlib import Path
+from types import SimpleNamespace
+
+REPO_ROOT = Path(__file__).resolve().parents[1]
+
+_failures: list[str] = []
+
+
+def check(label: str, condition: bool, detail: str = "") -> bool:
+    print(f"{'PASS' if condition else 'FAIL'} {label}" + (f" :: {detail}" if detail else ""))
+    if not condition:
+        _failures.append(label)
+    return condition
+
+
+def _fill(store, memory_limit: int) -> list[str]:
+    facts = [
+        "工作：Hermes 桌面端以 0.22.5-fork.1 交付，跟随上游稳定 tag 升级（T-07）。",
+        "环境：Windows 11 + Python 3.14.2 + Node 24；桌面构建用仓库自带 electron-builder。",
+        "约定：记忆写入超限必须拒绝并返回剩余字符数，不静默截断（PRD §7.2）。",
+        "约定：笔记目录名只能用 work/study/life/health/finance/people/other。",
+        "偏好：回答先给结论，再给依据；不写客套话。",
+        "排查：Windows 上 pytest 的 chmod 断言只适用于 posix，已按平台标记。",
+        "流程：任务收尾先改 TODO.md，再写 MEMORY.md，最后回报。",
+    ]
+    for fact in facts:
+        result = store.add("memory", fact)
+        assert result.get("success"), result
+    from tools.memory_tool_store import ENTRY_DELIMITER
+
+    stale = "旧结论：桌面端还在用 MSIX 打包（已作废，改 nsis + portable）。"
+    padding = memory_limit - store._char_count("memory") - len(ENTRY_DELIMITER) - len(stale) - 32
+    stale += "旧打包说明。" * (padding // len("旧打包说明。"))
+    result = store.add("memory", stale)
+    assert result.get("success"), result
+    facts.append(stale)
+    assert 0 <= memory_limit - store._char_count("memory") <= 40
+    return facts
+
+
+def main() -> int:
+    sys.path.insert(0, str(REPO_ROOT))
+    with tempfile.TemporaryDirectory(prefix="hermes-t05-") as tmp:
+        home = Path(tmp)
+        os.environ["HERMES_HOME"] = str(home)
+        print(f"temp HERMES_HOME: {home}")
+
+        from tools.memory_tool_store import ENTRY_DELIMITER, MemoryStore
+
+        store = MemoryStore()
+        store.load_from_disk()
+        facts = _fill(store, store.memory_char_limit)
+        store.add("user", "称呼：直接叫名字；时区 Asia/Hong_Kong。")
+        before_overflow = (home / "memories" / "MEMORY.md").read_bytes()
+
+        # 1. Near the cap, a new fact is refused with the remaining headroom, not truncated.
+        overflow = store.add("memory", "新事实：" + "压" * 260)
+        message = str(overflow.get("message") or overflow.get("error") or "")
+        check("near-cap add is refused", not overflow.get("success"), message[:90])
+        check("refusal reports chars still available", "chars remain available" in message)
+        check("stored entries are untouched after refusal", len(store.memory_entries) == len(facts))
+        check("file is byte-identical after refusal",
+              (home / "memories" / "MEMORY.md").read_bytes() == before_overflow)
+
+        # 2. Consolidation: fold two verbose entries into one conclusion and drop the stale MSIX one.
+        replaced = store.replace(
+            "memory",
+            "工作：Hermes 桌面端以 0.22.5-fork.1 交付",
+            "工作：桌面端 0.22.5-fork.1，Windows 出 nsis + portable，跟随上游稳定 tag 升级。",
+        )
+        check("verbose entry collapsed via replace", bool(replaced.get("success")), str(replaced.get("message"))[:60])
+        removed = store.remove("memory", "旧结论：桌面端还在用 MSIX 打包")
+        check("stale entry dropped via remove", bool(removed.get("success")), str(removed.get("message"))[:60])
+        added = store.add("memory", "打包：Windows 走 NSIS（per-user）+ portable，不做自动更新。")
+        check("new fact fits after consolidation", bool(added.get("success")), str(added.get("message"))[:60])
+
+        # 3. The fact that did not fit is extracted into a note using PRD §7.3 front matter.
+        from hermes_notes import NotesStore
+
+        notes = NotesStore(home)
+        note_path = notes.note_path("work", "hermes-packaging")
+        note_path.parent.mkdir(parents=True, exist_ok=True)
+        note_path.write_text(
+            "---\n"
+            "name: Hermes 打包方案\n"
+            "description: Windows 走 NSIS 与 portable，不做自动更新，升级靠覆盖安装\n"
+            "updated: 2026-11-03\n"
+            "---\n\n"
+            "Windows 用 NSIS per-user 安装加 portable 试跑；覆盖安装只换程序目录，\n"
+            "HERMES_HOME 下的 memories/ 与 notes/ 不动。\n",
+            encoding="utf-8",
+        )
+        front = note_path.read_text(encoding="utf-8-sig").split("\n---\n", 1)[0]
+        fields = dict(
+            line.split(": ", 1) for line in front.splitlines() if ": " in line and not line.startswith("---")
+        )
+        check("note carries name/description/updated", set(fields) == {"name", "description", "updated"},
+              ", ".join(sorted(fields)))
+        check("description stays on one line and <= 40 chars", len(fields["description"]) <= 40,
+              str(len(fields["description"])))
+        check("topic lives under notes/work/", note_path == home / "notes" / "work" / "hermes-packaging.md")
+
+        # 4. New session = fresh store + fresh notes scan; nothing carries over in memory.
+        fresh = MemoryStore()
+        fresh.load_from_disk()
+        memory_block = fresh.format_for_system_prompt("memory") or ""
+        user_block = fresh.format_for_system_prompt("user") or ""
+        index = notes.render_index()
+
+        check("fresh store still within MEMORY limit", fresh._char_count("memory") <= 2200,
+              f"{fresh._char_count('memory')}/2200")
+        check("fresh store still within USER limit", fresh._char_count("user") <= 1375,
+              f"{fresh._char_count('user')}/1375")
+        check("combined memory budget <= 3575", fresh._char_count("memory") + fresh._char_count("user") <= 3575)
+        check("count is delimited entries, not the banner",
+              fresh._char_count("memory") == len(ENTRY_DELIMITER.join(fresh.memory_entries)),
+              f"delimiter={ENTRY_DELIMITER!r}")
+        check("banner percentage matches the counted chars",
+              f"{fresh._char_count('memory'):,}/2,200 chars" in memory_block, memory_block.splitlines()[1] if memory_block else "")
+        check("consolidated conclusion survives the new session", "nsis + portable" in memory_block)
+        check("dropped MSIX conclusion is gone", "MSIX" not in memory_block)
+        check("notes index shows display name/name/summary",
+              "- 工作/Hermes 打包方案 — Windows 走 NSIS 与 portable" in index, index.splitlines()[-1])
+        check("note body is not injected", "覆盖安装只换程序目录" not in index)
+
+        # 5. Fresh-session prompt order: MEMORY -> USER -> notes index, the PRD §7.5 tail.
+        from agent.system_prompt import _memory_parts
+
+        stub = SimpleNamespace(
+            _memory_store=fresh,
+            _memory_enabled=True,
+            _user_profile_enabled=True,
+            _memory_manager=None,
+        )
+        parts = _memory_parts(stub)
+        check("three tail parts rendered (MEMORY, USER, notes)", len(parts) == 3, str(len(parts)))
+        check("tail order is MEMORY -> USER -> notes",
+              bool(parts) and parts[0] == memory_block and parts[1] == user_block
+              and parts[2].startswith("NOTES INDEX"))
+
+        print("\nrendered tail (first line of each part):")
+        for part in parts:
+            print(f"  {part.splitlines()[0]}")
+
+    print()
+    if _failures:
+        print(f"RESULT: {len(_failures)} check(s) failed -> {', '.join(_failures)}")
+        return 1
+    print("RESULT: every check passed")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
