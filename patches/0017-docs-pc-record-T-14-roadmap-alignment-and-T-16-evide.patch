+Get-FileHash -Algorithm SHA256 -LiteralPath 'D:\DSH-temp\开源替代-Muse-TodayAI\选定方案与实施路线-20261024.html','D:\DSH-temp\开源替代-Muse-TodayAI\技术白皮书-隐私与反锁定-20261024.html'
