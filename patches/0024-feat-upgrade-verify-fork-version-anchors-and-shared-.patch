+#!/usr/bin/env python3
+"""Preflight an upstream stable-tag upgrade without touching the network.
+
+Read-only: inspects the configured remotes, the candidate tag, both version declarations, the
+checklist and the shared memory contract. It never fetches, edits, or rebases. ``--json`` emits a
+machine-readable report with ``blocked_reason`` (``null`` when nothing blocks).
+
+Usage::
+
+    python scripts/check_upstream_upgrade.py --tag v0.23.0
+    python scripts/check_upstream_upgrade.py --json
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import subprocess
+import sys
+from pathlib import Path
+
+REPO_ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(REPO_ROOT))
+sys.path.insert(0, str(REPO_ROOT / "scripts"))
+
+import fork_version
+import memory_contract
+import verify_version_anchor
+
+CHECKLIST = "UPSTREAM_UPGRADE_CHECKLIST.md"
+EXPECTED_UPSTREAM = "nousresearch/hermes-agent"
+CHECKLIST_ANCHORS = ("## 1", "## 2", "## 3", "## 4", "scripts/check", "check_upstream_memory.py")
+
+
+def _git(repo: Path, *args: str) -> str:
+    result = subprocess.run(["git", *args], cwd=repo, capture_output=True, text=True,
+                            encoding="utf-8", timeout=60, check=False)
+    return result.stdout.strip() if result.returncode == 0 else ""
+
+
+def _remotes(repo: Path) -> dict[str, str]:
+    remotes: dict[str, str] = {}
+    for line in _git(repo, "remote", "-v").splitlines():
+        parts = line.split()
+        if len(parts) >= 2:
+            remotes.setdefault(parts[0], parts[1])
+    return remotes
+
+
+def _check(name: str, ok: bool, detail: str) -> dict:
+    return {"name": name, "ok": ok, "detail": detail}
+
+
+def build_report(repo: Path = REPO_ROOT, tag: str | None = None) -> dict:
+    checks: list[dict] = []
+    remotes = _remotes(repo)
+    upstream = remotes.get("upstream")
+    checks.append(_check(
+        "upstream_remote", bool(upstream) and EXPECTED_UPSTREAM in (upstream or ""),
+        f"upstream={upstream or 'missing'}; origin={remotes.get('origin', 'missing')}"))
+
+    py_version, json_version = verify_version_anchor.declared_versions(repo)
+    current = None
+    if py_version and json_version:
+        try:
+            current = fork_version.parse(py_version)
+            if current != fork_version.parse(json_version):
+                checks.append(_check("declarations", False,
+                                     f"{py_version} vs {json_version} disagree"))
+            else:
+                checks.append(_check("declarations", True,
+                                     f"{current.display} ({current.pep440})"))
+        except ValueError as exc:
+            checks.append(_check("declarations", False, str(exc)))
+    else:
+        checks.append(_check("declarations", False, "pyproject.toml or apps/desktop/package.json "
+                                                   "has no version"))
+
+    local_tags = set(_git(repo, "tag", "--list").splitlines())
+    candidate = {"tag": tag, "stable": False, "present_locally": False, "base": None,
+                 "expected_next": None}
+    if not tag:
+        checks.append(_check("candidate_tag", False,
+                             "no candidate stable tag passed (use --tag vX.Y.Z)"))
+    elif not fork_version.is_stable_upstream_tag(tag):
+        checks.append(_check("candidate_tag", False,
+                             f"{tag!r} is not an upstream stable tag; fork/pre-release tags are rejected"))
+    elif tag not in local_tags:
+        candidate["stable"] = True
+        checks.append(_check("candidate_tag", False,
+                             f"{tag!r} is not present locally; fetch is disabled in this preflight"))
+    else:
+        candidate["stable"] = True
+        candidate["present_locally"] = True
+        base = tag.lstrip("v")
+        candidate["base"] = base
+        checks.append(_check("candidate_tag", True, f"{tag} points at {_git(repo, 'rev-parse', tag)[:12]}"))
+        if current is not None:
+            current_base = fork_version.parse(current.display).base
+            if base != current_base:
+                nxt = fork_version.ForkVersion(*[int(part) for part in base.split(".")], 1)
+            else:
+                nxt = fork_version.ForkVersion(*[int(part) for part in base.split(".")], current.fork + 1)
+            candidate["expected_next"] = {"display": nxt.display, "pep440": nxt.pep440,
+                                          "tag": nxt.tag}
+
+    checklist = repo / CHECKLIST
+    text = checklist.read_text(encoding="utf-8-sig") if checklist.exists() else ""
+    missing = [anchor for anchor in CHECKLIST_ANCHORS if anchor not in text]
+    checks.append(_check("checklist", bool(text) and not missing,
+                         "ok" if text and not missing else
+                         f"missing {CHECKLIST}" if not text else f"missing anchors: {missing}"))
+
+    drifts = memory_contract.compare()
+    checks.append(_check("memory_contract", not drifts,
+                         "aligned with evidence/fixtures/memory-contract.json" if not drifts
+                         else "; ".join(drifts)))
+
+    dirty = _git(repo, "status", "--porcelain")
+    warnings = []
+    if dirty:
+        warnings.append(f"{len(dirty.splitlines())} uncommitted path(s); commit or stash before rebasing")
+
+    blocked = [f"{check['name']}: {check['detail']}" for check in checks if not check["ok"]]
+    return {
+        "ok": not blocked,
+        "blocked_reason": "; ".join(blocked) if blocked else None,
+        "checks": checks,
+        "current": {"pyproject": py_version, "desktop": json_version},
+        "candidate": candidate,
+        "warnings": warnings,
+        "network": "not contacted (fetch disabled by this preflight)",
+    }
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__,
+                                     formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument("--repo", type=Path, default=REPO_ROOT)
+    parser.add_argument("--tag", help="candidate upstream stable tag, e.g. v0.23.0")
+    parser.add_argument("--json", action="store_true", help="emit the report as JSON")
+    args = parser.parse_args(argv)
+    report = build_report(args.repo, args.tag)
+    if args.json:
+        print(json.dumps(report, ensure_ascii=False, indent=2))
+    else:
+        print(f"current: {report['current']['pyproject']} / {report['current']['desktop']}")
+        for check in report["checks"]:
+            print(("PASS " if check["ok"] else "FAIL ") + f"{check['name']}: {check['detail']}")
+        for warning in report["warnings"]:
+            print(f"WARN {warning}")
+        print(f"next versions: {report['candidate']['expected_next']}")
+        print("RESULT: " + ("ready for the rebase steps" if report["ok"]
+                            else f"blocked -> {report['blocked_reason']}"))
+    return 0 if report["ok"] else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/scripts/fork_version.py b/scripts/fork_version.py
new file mode 100644
index 0000000000..dd21825e7a
--- /dev/null
+++ b/scripts/fork_version.py
@@ -0,0 +1,89 @@
+"""Fork version arithmetic for the ``<upstream>-fork.<N>`` scheme (Q7 / PRD §5.4 v0.8).
+
+Two spellings describe the same release and both are checked into the tree:
+
+* display (SemVer-ish, used by ``apps/desktop/package.json`` and the git tag): ``0.22.5-fork.1``
+* PEP 440 (used by ``pyproject.toml``): ``0.22.5+fork1``
+
+Rules: the base follows the upstream stable release exactly; ``N`` starts at 1 for a base, resets to 1
+on a rebase, and only increments for another package cut from the same base.
+"""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+_DISPLAY_RE = re.compile(
+    r"^(?P<major>0|[1-9]\d*)\.(?P<minor>0|[1-9]\d*)\.(?P<patch>0|[1-9]\d*)"
+    r"-fork\.(?P<fork>[1-9]\d*)$"
+)
+_PEP440_RE = re.compile(
+    r"^(?P<major>0|[1-9]\d*)\.(?P<minor>0|[1-9]\d*)\.(?P<patch>0|[1-9]\d*)"
+    r"\+fork\.?(?P<fork>[1-9]\d*)$"
+)
+
+
+@dataclass(frozen=True)
+class ForkVersion:
+    major: int
+    minor: int
+    patch: int
+    fork: int
+
+    @property
+    def base(self) -> str:
+        return f"{self.major}.{self.minor}.{self.patch}"
+
+    @property
+    def display(self) -> str:
+        return f"{self.base}-fork.{self.fork}"
+
+    @property
+    def pep440(self) -> str:
+        return f"{self.base}+fork{self.fork}"
+
+    @property
+    def tag(self) -> str:
+        return f"v{self.display}"
+
+
+def parse(text: str) -> ForkVersion:
+    """Parse either spelling (an optional leading ``v`` is accepted); raise ValueError otherwise."""
+    value = (text or "").strip()
+    if value[:1] in ("v", "V"):
+        value = value[1:]
+    for pattern in (_DISPLAY_RE, _PEP440_RE):
+        match = pattern.fullmatch(value)
+        if match:
+            return ForkVersion(int(match["major"]), int(match["minor"]),
+                               int(match["patch"]), int(match["fork"]))
+    raise ValueError(
+        f"not a fork version: {text!r}; expected '<base>-fork.<N>' or '<base>+fork<N>' with N >= 1")
+
+
+def equivalent(left: str, right: str) -> bool:
+    """True when two spellings describe the same base and fork number."""
+    try:
+        return parse(left) == parse(right)
+    except ValueError:
+        return False
+
+
+def canonical_pep440(text: str) -> str:
+    return parse(text).pep440
+
+
+def canonical_display(text: str) -> str:
+    return parse(text).display
+
+
+def tag_for(text: str) -> str:
+    return parse(text).tag
+
+
+def is_stable_upstream_tag(tag: str) -> bool:
+    """Delegate to the updater's rule so a fork tag can never be mistaken for upstream stable."""
+    from hermes_cli.update_channel import STABLE_TAG_RE
+
+    return bool(STABLE_TAG_RE.fullmatch(tag or ""))
diff --git a/scripts/memory_contract.py b/scripts/memory_contract.py
new file mode 100644
index 0000000000..85f7570207
--- /dev/null
+++ b/scripts/memory_contract.py
@@ -0,0 +1,101 @@
+"""The cross-client memory contract: one fixture, read by scripts and tests.
+
+The contract lives in ``evidence/fixtures/memory-contract.json`` and mirrors the Android client
+(kourichat-next): MEMORY.md model writes default 3,000 chars (0 = unlimited), USER.md uncapped, no
+combined budget, code-point + cluster-tail counting, ``\\n§\\n`` entries, seven writable categories
+plus read-only ``docs/``, and the root prompt first in the stable tier.
+"""
+
+from __future__ import annotations
+
+import inspect
+import json
+from pathlib import Path
+
+REPO_ROOT = Path(__file__).resolve().parents[1]
+FIXTURE = REPO_ROOT / "evidence" / "fixtures" / "memory-contract.json"
+
+
+def load_fixture(path: Path = FIXTURE) -> dict:
+    return json.loads(path.read_text(encoding="utf-8-sig"))
+
+
+def _store_defaults() -> dict:
+    from tools.memory_tool_store import MemoryStore
+
+    signature = inspect.signature(MemoryStore.__init__)
+    return {
+        "memory_char_limit": signature.parameters["memory_char_limit"].default,
+        "user_char_limit": signature.parameters["user_char_limit"].default,
+    }
+
+
+def live_contract() -> dict:
+    """Read the contract straight from the running code (signatures, constants, counting probes)."""
+    from agent.system_prompt import MEMORY_ROOT_PROMPT
+    from hermes_charcount import char_count
+    from hermes_notes import CATEGORY_DISPLAY_NAMES, WRITABLE_CATEGORIES
+    from tools.memory_tool_store import ENTRY_DELIMITER
+
+    defaults = _store_defaults()
+    probes = {
+        "plain": "ab",
+        "combining": "e\u0301",
+        "family_zwj": "\U0001F468\u200d\U0001F469\u200d\U0001F467\u200d\U0001F466",
+        "flag": "\U0001F1E8\U0001F1F3",
+        "tag_sequence": "\U0001F3F4\U000E0067\U000E0062\U000E0065\U000E006E\U000E0067\U000E007F",
+    }
+    return {
+        "entry_delimiter": ENTRY_DELIMITER,
+        **defaults,
+        "categories": sorted(CATEGORY_DISPLAY_NAMES),
+        "readonly_categories": sorted(set(CATEGORY_DISPLAY_NAMES) - set(WRITABLE_CATEGORIES)),
+        "counting": {
+            "probes": probes,
+            "expected_counts": {name: char_count(value) for name, value in probes.items()},
+        },
+        "root_prompt": {
+            "present": bool(MEMORY_ROOT_PROMPT.strip()),
+            "anchor": "running inside Hermes' local memory system",
+            "anchor_found": "running inside Hermes' local memory system" in MEMORY_ROOT_PROMPT,
+            "text": MEMORY_ROOT_PROMPT,
+        },
+    }
+
+
+def compare(live: dict | None = None, fixture: dict | None = None) -> list[str]:
+    """Return human-readable drifts between the live code and the shared fixture (empty = aligned)."""
+    live = live if live is not None else live_contract()
+    fixture = fixture if fixture is not None else load_fixture()
+    drifts: list[str] = []
+    if live["entry_delimiter"] != fixture["entry_delimiter"]:
+        drifts.append(f"delimiter: live={live['entry_delimiter']!r} fixture={fixture['entry_delimiter']!r}")
+    for key in ("memory_char_limit", "user_char_limit"):
+        if live[key] != fixture[key]:
+            drifts.append(f"{key}: live={live[key]} fixture={fixture[key]}")
+    expected_categories = sorted(
+        set(fixture["categories"]) | set(fixture["readonly_categories"]) | {"other"})
+    if live["categories"] != expected_categories:
+        drifts.append(f"categories: live={live['categories']} fixture={expected_categories}")
+    if live["readonly_categories"] != sorted(fixture["readonly_categories"]):
+        drifts.append(f"read-only categories: live={live['readonly_categories']} "
+                      f"fixture={sorted(fixture['readonly_categories'])}")
+    for name, expected in fixture["counting"]["expected_counts"].items():
+        actual = live["counting"]["expected_counts"].get(name)
+        if actual != expected:
+            drifts.append(f"char_count({name}): live={actual} fixture={expected}")
+    if fixture["root_prompt"]["required"] and not live["root_prompt"]["present"]:
+        drifts.append("root prompt: missing from agent.system_prompt")
+    if fixture["root_prompt"]["required"] and not live["root_prompt"]["anchor_found"]:
+        drifts.append("root prompt: fixture anchor text no longer present")
+    if fixture.get("combined_limit") is not None:
+        drifts.append("fixture asks for a combined limit; PC has none")
+    return drifts
+
+
+def report() -> dict:
+    live = live_contract()
+    root = live.pop("root_prompt")
+    live["root_prompt_present"] = bool(root["present"] and root["anchor_found"])
+    drifts = compare()
+    return {"ok": not drifts, "fixture": str(FIXTURE), "live": live, "drifts": drifts}
diff --git a/scripts/verify_version_anchor.py b/scripts/verify_version_anchor.py
new file mode 100644
index 0000000000..cf60d8cd28
--- /dev/null
+++ b/scripts/verify_version_anchor.py
@@ -0,0 +1,131 @@
+"""Assert the fork version is one release across pyproject, the desktop package and the git tag.
+
+Usage::
+
+    python scripts/verify_version_anchor.py            # release gate: HEAD must carry the tag
+    python scripts/verify_version_anchor.py --commit <rev>
+    python scripts/verify_version_anchor.py --json
+
+Exit code 0 means: both declarations parse, describe the same base/fork, and the git tag at the
+target revision is exactly ``v<base>-fork.<N>``. ``--allow-distance`` keeps the declaration check
+but downgrades "tag not exactly at the revision" to a warning (useful on work-in-progress history).
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import re
+import subprocess
+import sys
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+
+import fork_version
+
+REPO_ROOT = Path(__file__).resolve().parents[1]
+PYPROJECT = "pyproject.toml"
+DESKTOP_PACKAGE = "apps/desktop/package.json"
+
+
+def _git(repo: Path, *args: str) -> str | None:
+    result = subprocess.run(["git", *args], cwd=repo, capture_output=True, text=True,
+                            encoding="utf-8", timeout=60, check=False)
+    return result.stdout.strip() if result.returncode == 0 else None
+
+
+def show_file(repo: Path, relative: str, rev: str | None) -> str | None:
+    if rev is None:
+        path = repo / relative
+        return path.read_text(encoding="utf-8-sig") if path.exists() else None
+    return _git(repo, "show", f"{rev}:{relative}")
+
+
+def declared_versions(repo: Path, rev: str | None = None) -> tuple[str | None, str | None]:
+    pyproject = show_file(repo, PYPROJECT, rev)
+    desktop = show_file(repo, DESKTOP_PACKAGE, rev)
+    py_version = re.search(r'^version\s*=\s*"([^"]+)"', pyproject or "", re.MULTILINE)
+    json_version = re.search(r'"version"\s*:\s*"([^"]+)"', desktop or "")
+    return (py_version.group(1) if py_version else None,
+            json_version.group(1) if json_version else None)
+
+
+def check(repo: Path, *, rev: str | None = None, allow_distance: bool = False) -> dict:
+    reasons: list[str] = []
+    py_version, json_version = declared_versions(repo, rev)
+    target = rev or "HEAD"
+    report: dict = {
+        "ok": False, "target": target, "pyproject": py_version, "desktop": json_version,
+        "expected_tag": None, "describe": None, "reasons": reasons,
+    }
+    if py_version is None:
+        reasons.append(f"{PYPROJECT} has no version field")
+    if json_version is None:
+        reasons.append(f"{DESKTOP_PACKAGE} has no version field")
+    if reasons:
+        return report
+    try:
+        parsed = fork_version.parse(py_version)
+        desktop = fork_version.parse(json_version)
+    except ValueError as exc:
+        reasons.append(str(exc))
+        return report
+    report["expected_tag"] = parsed.tag
+    if parsed != desktop:
+        reasons.append(f"declarations disagree: {PYPROJECT}={py_version} vs "
+                       f"{DESKTOP_PACKAGE}={json_version}")
+    if py_version != parsed.pep440:
+        reasons.append(f"{PYPROJECT} is not canonical PEP 440: {py_version!r} != {parsed.pep440!r}")
+    if json_version != parsed.display:
+        reasons.append(f"{DESKTOP_PACKAGE} is not canonical display: {json_version!r} != {parsed.display!r}")
+
+    exact = _git(repo, "describe", "--tags", "--exact-match", target)
+    if exact is None:
+        described = _git(repo, "describe", "--tags", target)
+        report["describe"] = described
+        if described is None:
+            reasons.append(f"{target} has no reachable tag")
+        else:
+            nearest = described.rsplit("-", 2)[0] if "-g" in described else described
+            if nearest != parsed.tag:
+                reasons.append(f"nearest tag {nearest!r} does not match {parsed.tag!r}")
+            elif allow_distance:
+                report["warning"] = f"{target} is past {parsed.tag}; rebuild with N+1 before release"
+            else:
+                reasons.append(f"{target} is not exactly at {parsed.tag} ({described}); "
+                               "cut the release tag or pass --allow-distance for a work-in-progress check")
+    else:
+        report["describe"] = exact
+        if exact != parsed.tag:
+            reasons.append(f"tag at {target} is {exact!r}, expected {parsed.tag!r}")
+    report["ok"] = not reasons
+    return report
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__,
+                                     formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument("--repo", type=Path, default=REPO_ROOT, help="repository root")
+    parser.add_argument("--commit", dest="rev", help="check this revision instead of HEAD")
+    parser.add_argument("--allow-distance", action="store_true",
+                        help="warn (not fail) when the revision is past the tag")
+    parser.add_argument("--json", action="store_true", help="emit the report as JSON")
+    args = parser.parse_args(argv)
+    report = check(args.repo, rev=args.rev, allow_distance=args.allow_distance)
+    if args.json:
+        print(json.dumps(report, ensure_ascii=False, indent=2))
+    else:
+        print(f"target: {report['target']}")
+        print(f"pyproject: {report['pyproject']} | desktop: {report['desktop']} | "
+              f"tag: {report['expected_tag']} | describe: {report['describe']}")
+        if report.get("warning"):
+            print(f"WARN {report['warning']}")
+        for reason in report["reasons"]:
+            print(f"FAIL {reason}")
+        print("RESULT: " + ("ok" if report["ok"] else "mismatch"))
+    return 0 if report["ok"] else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
