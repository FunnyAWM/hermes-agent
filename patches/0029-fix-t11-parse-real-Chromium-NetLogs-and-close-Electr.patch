+        stderr=subprocess.DEVNULL,
+    )
     try:
         endpoints = _sample_connections(proc.pid, duration)
     finally:
-        if proc.poll() is None:
-            proc.kill()
-        proc.wait(timeout=30)
-    return {"netlog": str(netlog), "remote_endpoints": endpoints}
