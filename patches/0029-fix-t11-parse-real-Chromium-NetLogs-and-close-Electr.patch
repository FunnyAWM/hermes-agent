+def _dedupe_violations(items: list[dict]) -> list[dict]:
+    seen: set[tuple[str, str]] = set()
+    unique: list[dict] = []
+    for item in items:
+        key = (str(item.get("host")), str(item.get("reason")))
+        if key not in seen:
+            seen.add(key)
+            unique.append(item)
+    return unique
