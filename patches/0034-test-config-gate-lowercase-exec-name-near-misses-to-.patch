From db632e481c7969f00597ad8b884af5bc25099505 Mon Sep 17 00:00:00 2001
From: FunnyAWM <1142978300@qq.com>
Date: Fri, 6 Nov 2026 12:22:55 +0800
Subject: [PATCH] test(config): gate lowercase exec-name near-misses to POSIX

On POSIX a lowercase ld_preload / git_config_parameters is a different,
inert variable; Windows env names are case-insensitive, so the writer
correctly refuses them. The parametrized case asserted POSIX semantics
everywhere. Split it into a platforms("posix") test; the Windows
mixed-case denial stays covered by the existing injected-flag test.
---
 tests/hermes_cli/test_config.py | 13 +++++++++++--
 1 file changed, 11 insertions(+), 2 deletions(-)

diff --git a/tests/hermes_cli/test_config.py b/tests/hermes_cli/test_config.py
index b64ead79cd..d72c9b315a 100644
--- a/tests/hermes_cli/test_config.py
+++ b/tests/hermes_cli/test_config.py
@@ -1374,8 +1374,6 @@ class TestEnvWriteDenylist:
             # Non-exec git env names a user may legitimately persist.
             "GIT_COMMITTER_NAME", "GIT_AUTHOR_NAME", "GIT_TERMINAL_PROMPT",
             "GIT_EDITOR_WIDE",  # near-miss: not the real GIT_EDITOR
-            # POSIX case: lowercase exec names are different, inert variables.
-            "git_config_parameters", "ld_preload",
         ],
     )
     def test_non_exec_near_misses_still_writable(self, allowed_key):
@@ -1383,6 +1381,17 @@ class TestEnvWriteDenylist:
         env = load_env()
         assert env[allowed_key] == "test-value-123"
 
+    @pytest.mark.parametrize("allowed_key", ["git_config_parameters", "ld_preload"])
+    @pytest.mark.platforms("posix")
+    def test_lowercase_exec_names_are_inert_on_posix(self, allowed_key):
+        """POSIX env names are case-sensitive, so the lowercase spelling of a denied
+        exec-influence name is a different, inert variable. On Windows the same
+        spelling normalizes onto the denylist — covered by
+        test_windows_policy_denies_mixed_case_exec_names."""
+        save_env_value(allowed_key, "test-value-123")
+        env = load_env()
+        assert env[allowed_key] == "test-value-123"
+
     @pytest.mark.parametrize("protected_key", ["Ld_Preload", "Git_Config_Parameters"])
     def test_windows_policy_denies_mixed_case_exec_names(self, protected_key, monkeypatch):
         """Windows env names are case-insensitive, so the writer must refuse the mixed-case

