diff --git a/scripts/verify_pc_acceptance.py b/scripts/verify_pc_acceptance.py
new file mode 100644
index 0000000000..da7fa4d99f
--- /dev/null
+++ b/scripts/verify_pc_acceptance.py
@@ -0,0 +1,214 @@
+#!/usr/bin/env python3
+"""Validate (and optionally run) the PC acceptance manifest.
+
+The manifest is the single entry point for "is every PC task actually done?".
+Structural validation always runs; ``--run`` additionally executes each
+completed task's verification command and reports failures per task.
+
+Exit codes:
+  0  all tasks completed (and every command passed with --run)
+  1  a completed task's command failed, or blocked tasks exist without --allow-blocked
+  2  the manifest itself is invalid
+  3  blocked tasks exist and --allow-blocked was passed
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import re
+import subprocess
+import sys
+from pathlib import Path
+
+REPO_ROOT = Path(__file__).resolve().parents[1]
+DEFAULT_MANIFEST = Path(__file__).with_name("pc_acceptance_manifest.json")
+STATUSES = {"completed", "blocked"}
+TASK_ID = re.compile(r"^T-\d+[a-z]?$")
+
+
+def load_manifest(path: Path) -> dict:
+    return json.loads(path.read_text(encoding="utf-8-sig"))
+
+
+def _require_path(value, *, field: str, task_id: str, errors: list[str]) -> None:
+    if not isinstance(value, str) or not value.strip():
+        errors.append(f"{task_id}: {field} must be a non-empty path")
+        return
+    if not (REPO_ROOT / value).exists():
+        errors.append(f"{task_id}: {field} does not exist: {value}")
+
+
+def validate(manifest: dict) -> list[str]:
+    """Return every structural problem; an empty list means the manifest is usable."""
+    errors: list[str] = []
+    if manifest.get("schema") != 1:
+        errors.append("schema must be 1")
+    tasks = manifest.get("tasks")
+    if not isinstance(tasks, list) or not tasks:
+        return [*errors, "tasks must be a non-empty list"]
+
+    seen: set[str] = set()
+    for index, task in enumerate(tasks):
+        if not isinstance(task, dict):
+            errors.append(f"tasks[{index}] must be an object")
+            continue
+        task_id = str(task.get("id", f"tasks[{index}]"))
+        if not TASK_ID.match(task_id):
+            errors.append(f"{task_id}: id must look like T-01 or T-09b")
+        if task_id in seen:
+            errors.append(f"{task_id}: duplicate id")
+        seen.add(task_id)
+
+        if not isinstance(task.get("title"), str) or not task["title"].strip():
+            errors.append(f"{task_id}: title is required")
+
+        status = task.get("status")
+        if status not in STATUSES:
+            errors.append(f"{task_id}: status must be one of {sorted(STATUSES)}")
+            continue
+
+        evidence = task.get("evidence")
+        if not isinstance(evidence, list) or not evidence:
+            errors.append(f"{task_id}: evidence must be a non-empty list")
+        else:
+            for item in evidence:
+                _require_path(item, field="evidence", task_id=task_id, errors=errors)
+
+        command = task.get("command")
+        if command is not None and (
+            not isinstance(command, list)
+            or not command
+            or not all(isinstance(part, str) and part for part in command)
+        ):
+            errors.append(f"{task_id}: command must be a non-empty argv list or null")
+
+        if status == "completed":
+            if not command:
+                errors.append(f"{task_id}: completed tasks need a verification command")
+            if task.get("blocked_reason"):
+                errors.append(
+                    f"{task_id}: completed task must not carry a blocked_reason"
+                )
+            if task.get("handoff"):
+                errors.append(f"{task_id}: completed task must not carry a handoff")
+        else:
+            reason = task.get("blocked_reason")
+            if not isinstance(reason, str) or not reason.strip():
+                errors.append(f"{task_id}: blocked task needs a blocked_reason")
+            _require_path(
+                task.get("handoff"), field="handoff", task_id=task_id, errors=errors
+            )
+    return errors
+
+
+def summarize(manifest: dict) -> dict:
+    tasks = manifest.get("tasks", [])
+    return {
+        "total": len(tasks),
+        "completed": sum(task.get("status") == "completed" for task in tasks),
+        "blocked": sum(task.get("status") == "blocked" for task in tasks),
+    }
+
+
+def run_tasks(manifest: dict, *, timeout: float) -> list[dict]:
+    results: list[dict] = []
+    for task in manifest.get("tasks", []):
+        if task.get("status") != "completed":
+            continue
+        command = task.get("command")
+        try:
+            proc = subprocess.run(
+                command,
+                cwd=REPO_ROOT,
+                capture_output=True,
+                text=True,
+                encoding="utf-8",
+                errors="replace",
+                timeout=task.get("timeout", timeout),
+                check=False,
+            )
+            ok = proc.returncode == 0
+            detail = "" if ok else (proc.stderr or proc.stdout or "").strip()[-400:]
+        except (OSError, subprocess.TimeoutExpired) as exc:
+            ok = False
+            detail = str(exc)
+        results.append({"id": task["id"], "ok": ok, "detail": detail})
+    return results
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--manifest", type=Path, default=DEFAULT_MANIFEST)
+    parser.add_argument(
+        "--run", action="store_true", help="execute every completed task's command"
+    )
+    parser.add_argument(
+        "--timeout", type=float, default=900.0, help="per-command timeout in seconds"
+    )
+    parser.add_argument(
+        "--allow-blocked",
+        action="store_true",
+        help="treat blocked tasks as a handoff state (exit 3) instead of a failure",
+    )
+    parser.add_argument("--json", action="store_true", help="print a JSON summary")
+    args = parser.parse_args(argv)
+
+    try:
+        manifest = load_manifest(args.manifest)
+    except (OSError, ValueError) as exc:
+        print(f"invalid manifest: {exc}", file=sys.stderr)
+        return 2
+
+    errors = validate(manifest)
+    summary = summarize(manifest)
+    report: dict = {
+        "manifest": str(args.manifest),
+        "summary": summary,
+        "errors": errors,
+        "results": [],
+        "blocked": [],
+    }
+    if errors:
+        if args.json:
+            print(json.dumps(report, ensure_ascii=False, indent=2))
+        else:
+            for error in errors:
+                print(f"[FAIL] {error}", file=sys.stderr)
+        return 2
+
+    report["blocked"] = [
+        task["id"] for task in manifest["tasks"] if task["status"] == "blocked"
+    ]
+
+    failures = 0
+    if args.run:
+        for result in run_tasks(manifest, timeout=args.timeout):
+            report["results"].append(result)
+            if not result["ok"]:
+                failures += 1
+            if not args.json:
+                state = "ok" if result["ok"] else "FAIL"
+                print(
+                    f"[{state}] {result['id']}"
+                    + (f": {result['detail']}" if not result["ok"] else "")
+                )
+
+    if args.json:
+        print(json.dumps(report, ensure_ascii=False, indent=2))
+    else:
+        print(
+            f"{summary['completed']} completed / {summary['blocked']} blocked / "
+            f"{summary['total']} tasks"
+            + (f"; {failures} verification command(s) failed" if args.run else "")
+        )
+
+    if failures:
+        return 1
+    if summary["blocked"]:
+        return 3 if args.allow_blocked else 1
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/tests/scripts/test_pc_acceptance_manifest.py b/tests/scripts/test_pc_acceptance_manifest.py
new file mode 100644
index 0000000000..806c50cc62
--- /dev/null
+++ b/tests/scripts/test_pc_acceptance_manifest.py
@@ -0,0 +1,142 @@
+"""The PC acceptance manifest is the single gate: structural errors must fail."""
+
+from __future__ import annotations
+
+import importlib.util
+import json
+import sys
+from pathlib import Path
+
+REPO_ROOT = Path(__file__).resolve().parents[2]
+SCRIPT = REPO_ROOT / "scripts" / "verify_pc_acceptance.py"
+REAL_MANIFEST = REPO_ROOT / "scripts" / "pc_acceptance_manifest.json"
+
+
+def _load():
+    spec = importlib.util.spec_from_file_location(
+        "verify_pc_acceptance_under_test", SCRIPT
+    )
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    assert spec.loader is not None
+    spec.loader.exec_module(module)
+    return module
+
+
+verify = _load()
+
+
+def _task(task_id="T-01", **overrides):
+    task = {
+        "id": task_id,
+        "title": "fixture",
+        "status": "completed",
+        "command": [sys.executable, "-c", "raise SystemExit(0)"],
+        "evidence": ["evidence/t01.md"],
+        "blocked_reason": None,
+        "handoff": None,
+    }
+    task.update(overrides)
+    return task
+
+
+def _write(tmp_path: Path, tasks) -> Path:
+    path = tmp_path / "manifest.json"
+    path.write_text(json.dumps({"schema": 1, "tasks": tasks}), encoding="utf-8")
+    return path
+
+
+def test_real_manifest_is_structurally_valid():
+    manifest = verify.load_manifest(REAL_MANIFEST)
+    assert verify.validate(manifest) == []
+    summary = verify.summarize(manifest)
+    assert summary == {"total": 20, "completed": 15, "blocked": 5}
+    blocked = [task for task in manifest["tasks"] if task["status"] == "blocked"]
+    assert {task["id"] for task in blocked} == {
+        "T-07",
+        "T-09b",
+        "T-09c",
+        "T-10",
+        "T-13",
+    }
+    assert all(task["blocked_reason"] and task["handoff"] for task in blocked)
+
+
+def test_blocked_task_requires_reason_and_handoff(tmp_path):
+    manifest = {"schema": 1, "tasks": [_task(status="blocked", command=None)]}
+    errors = verify.validate(manifest)
+    assert any("blocked_reason" in error for error in errors)
+    assert any("handoff" in error for error in errors)
+
+
+def test_completed_task_requires_command_and_existing_evidence(tmp_path):
+    manifest = {
+        "schema": 1,
+        "tasks": [_task(command=None, evidence=["evidence/nope.md"])],
+    }
+    errors = verify.validate(manifest)
+    assert any("verification command" in error for error in errors)
+    assert any("does not exist" in error for error in errors)
+
+
+def test_duplicate_and_malformed_ids_are_rejected():
+    manifest = {"schema": 1, "tasks": [_task(), _task("T-01"), _task("nope")]}
+    errors = verify.validate(manifest)
+    assert any("duplicate id" in error for error in errors)
+    assert any("must look like" in error for error in errors)
+
+
+def test_completed_task_must_not_carry_handoff_or_reason():
+    manifest = {
+        "schema": 1,
+        "tasks": [_task(blocked_reason="why", handoff="evidence/t01.md")],
+    }
+    errors = verify.validate(manifest)
+    assert any("must not carry a blocked_reason" in error for error in errors)
+    assert any("must not carry a handoff" in error for error in errors)
+
+
+def test_invalid_manifest_exits_2(tmp_path, capsys):
+    path = tmp_path / "broken.json"
+    path.write_text("{not json", encoding="utf-8")
+    assert verify.main(["--manifest", str(path)]) == 2
+    assert "invalid manifest" in capsys.readouterr().err
+
+
+def test_all_completed_and_passing_commands_exit_0(tmp_path):
+    path = _write(tmp_path, [_task()])
+    assert verify.main(["--manifest", str(path), "--run"]) == 0
+
+
+def test_failing_command_exits_1(tmp_path, capsys):
+    path = _write(
+        tmp_path, [_task(command=[sys.executable, "-c", "raise SystemExit(7)"])]
+    )
+    assert verify.main(["--manifest", str(path), "--run"]) == 1
+    assert "[FAIL] T-01" in capsys.readouterr().out
+
+
+def test_blocked_manifest_exits_1_unless_allowed(tmp_path):
+    path = _write(
+        tmp_path,
+        [
+            _task(),
+            _task(
+                "T-02",
+                status="blocked",
+                command=None,
+                blocked_reason="needs Android hardware",
+                handoff="evidence/handoff/T-09b.md",
+            ),
+        ],
+    )
+    assert verify.main(["--manifest", str(path)]) == 1
+    assert verify.main(["--manifest", str(path), "--allow-blocked"]) == 3
+
+
+def test_json_summary_is_pure_json(tmp_path, capsys):
+    path = _write(tmp_path, [_task()])
+    assert verify.main(["--manifest", str(path), "--run", "--json"]) == 0
+    payload = json.loads(capsys.readouterr().out)
+    assert payload["summary"] == {"total": 1, "completed": 1, "blocked": 0}
+    assert payload["results"][0]["id"] == "T-01"

