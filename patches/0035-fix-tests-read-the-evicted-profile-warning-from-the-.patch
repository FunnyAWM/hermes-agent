From 7e7f710e8fb95598f88ba84c2b04f297b7d0fc5a Mon Sep 17 00:00:00 2001
From: FunnyAWM <1142978300@qq.com>
Date: Fri, 6 Nov 2026 13:11:37 +0800
Subject: [PATCH 35/48] fix(tests): read the evicted-profile warning from the
 decoded receipt

The assertion compared a raw Windows path against json.dumps output, which
escapes the separators, so it could only ever match on POSIX. The receipt is
already a dict; assert against the message text instead. Red on the base
(evidence/t16-scoped.log:285 and the 2026-11-06 batch run), green via -k.
---
 tests/pm/test_plugin_survival_contract.py | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/tests/pm/test_plugin_survival_contract.py b/tests/pm/test_plugin_survival_contract.py
index c10b5cfbc3..2cc5057b21 100644
--- a/tests/pm/test_plugin_survival_contract.py
+++ b/tests/pm/test_plugin_survival_contract.py
@@ -557,7 +557,10 @@ def test_update_sync_survives_unreadable_secondary_profile(admission_env):
     workspace = Path(Facts(runtime_facts_path(core), strict=True).get("venv")["resolved_lock"]).parent
     assert "primary-dep" in (workspace / "pyproject.toml").read_text()
     assert broken.read_text(encoding="utf-8") == "plugins: [broken]\n"
-    assert str(broken.parent) in json.dumps(_latest_receipt(home).get("warnings"))
+    # Compare against the decoded warning: `json.dumps` escapes Windows separators, so a raw
+    # path needle can only ever match on POSIX. The report must name the profile that sat out.
+    warnings = _latest_receipt(home).get("warnings") or []
+    assert any(str(broken.parent) in str(item.get("message", item)) for item in warnings)
     assert venv_is_current(project_root=core) is True
 
 
