From 0dc2e728a590f5982358b47542cdb32bc3900840 Mon Sep 17 00:00:00 2001
From: FunnyAWM <1142978300@qq.com>
Date: Fri, 6 Nov 2026 12:27:30 +0800
Subject: [PATCH] feat(acceptance): honour --out so a gate run leaves one
 artifact

---
 scripts/verify_pc_acceptance.py              | 54 +++++++++++++-------
 tests/scripts/test_pc_acceptance_manifest.py | 32 ++++++++++++
 2 files changed, 67 insertions(+), 19 deletions(-)

diff --git a/scripts/verify_pc_acceptance.py b/scripts/verify_pc_acceptance.py
index da7fa4d99f..bd5ee52bf9 100644
--- a/scripts/verify_pc_acceptance.py
+++ b/scripts/verify_pc_acceptance.py
@@ -137,6 +137,16 @@ def run_tasks(manifest: dict, *, timeout: float) -> list[dict]:
     return results
 
 
+def _emit(report: dict, args, text: str) -> None:
+    """Print per flag, and always honour --out so a gate run leaves one artifact."""
+    if args.out:
+        args.out.parent.mkdir(parents=True, exist_ok=True)
+        args.out.write_text(
+            json.dumps(report, ensure_ascii=False, indent=2), encoding="utf-8"
+        )
+    print(json.dumps(report, ensure_ascii=False, indent=2) if args.json else text)
+
+
 def main(argv: list[str] | None = None) -> int:
     parser = argparse.ArgumentParser(description=__doc__)
     parser.add_argument("--manifest", type=Path, default=DEFAULT_MANIFEST)
@@ -152,12 +162,18 @@ def main(argv: list[str] | None = None) -> int:
         help="treat blocked tasks as a handoff state (exit 3) instead of a failure",
     )
     parser.add_argument("--json", action="store_true", help="print a JSON summary")
+    parser.add_argument("--out", type=Path, help="write the JSON summary to this file")
     args = parser.parse_args(argv)
 
     try:
         manifest = load_manifest(args.manifest)
     except (OSError, ValueError) as exc:
         print(f"invalid manifest: {exc}", file=sys.stderr)
+        _emit(
+            {"manifest": str(args.manifest), "errors": [str(exc)], "exit": 2},
+            args,
+            f"invalid manifest: {exc}",
+        )
         return 2
 
     errors = validate(manifest)
@@ -170,11 +186,10 @@ def main(argv: list[str] | None = None) -> int:
         "blocked": [],
     }
     if errors:
-        if args.json:
-            print(json.dumps(report, ensure_ascii=False, indent=2))
-        else:
-            for error in errors:
-                print(f"[FAIL] {error}", file=sys.stderr)
+        report["exit"] = 2
+        for error in errors:
+            print(f"[FAIL] {error}", file=sys.stderr)
+        _emit(report, args, f"{len(errors)} manifest error(s)")
         return 2
 
     report["blocked"] = [
@@ -187,27 +202,28 @@ def main(argv: list[str] | None = None) -> int:
             report["results"].append(result)
             if not result["ok"]:
                 failures += 1
-            if not args.json:
+            if not args.json and not args.out:
                 state = "ok" if result["ok"] else "FAIL"
                 print(
                     f"[{state}] {result['id']}"
                     + (f": {result['detail']}" if not result["ok"] else "")
                 )
 
-    if args.json:
-        print(json.dumps(report, ensure_ascii=False, indent=2))
-    else:
-        print(
-            f"{summary['completed']} completed / {summary['blocked']} blocked / "
-            f"{summary['total']} tasks"
-            + (f"; {failures} verification command(s) failed" if args.run else "")
-        )
-
     if failures:
-        return 1
-    if summary["blocked"]:
-        return 3 if args.allow_blocked else 1
-    return 0
+        code = 1
+    elif summary["blocked"]:
+        code = 3 if args.allow_blocked else 1
+    else:
+        code = 0
+    report["exit"] = code
+    _emit(
+        report,
+        args,
+        f"{summary['completed']} completed / {summary['blocked']} blocked / "
+        f"{summary['total']} tasks"
+        + (f"; {failures} verification command(s) failed" if args.run else ""),
+    )
+    return code
 
 
 if __name__ == "__main__":
diff --git a/tests/scripts/test_pc_acceptance_manifest.py b/tests/scripts/test_pc_acceptance_manifest.py
index 806c50cc62..43a2056d23 100644
--- a/tests/scripts/test_pc_acceptance_manifest.py
+++ b/tests/scripts/test_pc_acceptance_manifest.py
@@ -140,3 +140,35 @@ def test_json_summary_is_pure_json(tmp_path, capsys):
     payload = json.loads(capsys.readouterr().out)
     assert payload["summary"] == {"total": 1, "completed": 1, "blocked": 0}
     assert payload["results"][0]["id"] == "T-01"
+
+
+def test_out_writes_the_same_report_the_gate_returned(tmp_path):
+    path = _write(tmp_path, [_task()])
+    report = tmp_path / "nested" / "acceptance.json"
+    assert verify.main(["--manifest", str(path), "--run", "--out", str(report)]) == 0
+    payload = json.loads(report.read_text(encoding="utf-8"))
+    assert payload["exit"] == 0
+    assert payload["results"] == [{"id": "T-01", "ok": True, "detail": ""}]
+
+
+def test_out_records_blocked_exit_3(tmp_path):
+    path = _write(
+        tmp_path,
+        [
+            _task(
+                "T-02",
+                status="blocked",
+                command=None,
+                blocked_reason="needs Android hardware",
+                handoff="evidence/handoff/T-09b.md",
+            )
+        ],
+    )
+    report = tmp_path / "acceptance.json"
+    assert (
+        verify.main(["--manifest", str(path), "--allow-blocked", "--out", str(report)])
+        == 3
+    )
+    payload = json.loads(report.read_text(encoding="utf-8"))
+    assert payload["exit"] == 3
+    assert payload["blocked"] == ["T-02"]

