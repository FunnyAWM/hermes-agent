Subject: [PATCH] test(config): move the POSIX lowercase exec-name case into
 its own file

The added platform split pushed tests/hermes_cli/test_config.py to 2029
lines, over its ratchet value on main, so the repo health gate failed.
Per the gate's own remedy the new test lives in a new test file; the
Windows mixed-case denial stays with the rest of the denylist suite.
---
 tests/hermes_cli/test_config.py            | 11 --------
 tests/hermes_cli/test_config_exec_names.py | 29 ++++++++++++++++++++++
 2 files changed, 29 insertions(+), 11 deletions(-)
 create mode 100644 tests/hermes_cli/test_config_exec_names.py

diff --git a/tests/hermes_cli/test_config.py b/tests/hermes_cli/test_config.py
index d72c9b315a..adb28bc2e2 100644
--- a/tests/hermes_cli/test_config.py
+++ b/tests/hermes_cli/test_config.py
@@ -1381,17 +1381,6 @@ class TestEnvWriteDenylist:
         env = load_env()
         assert env[allowed_key] == "test-value-123"
 
-    @pytest.mark.parametrize("allowed_key", ["git_config_parameters", "ld_preload"])
-    @pytest.mark.platforms("posix")
-    def test_lowercase_exec_names_are_inert_on_posix(self, allowed_key):
-        """POSIX env names are case-sensitive, so the lowercase spelling of a denied
-        exec-influence name is a different, inert variable. On Windows the same
-        spelling normalizes onto the denylist — covered by
-        test_windows_policy_denies_mixed_case_exec_names."""
-        save_env_value(allowed_key, "test-value-123")
-        env = load_env()
-        assert env[allowed_key] == "test-value-123"
-
     @pytest.mark.parametrize("protected_key", ["Ld_Preload", "Git_Config_Parameters"])
     def test_windows_policy_denies_mixed_case_exec_names(self, protected_key, monkeypatch):
         """Windows env names are case-insensitive, so the writer must refuse the mixed-case
diff --git a/tests/hermes_cli/test_config_exec_names.py b/tests/hermes_cli/test_config_exec_names.py
new file mode 100644
index 0000000000..d90230469b
--- /dev/null
+++ b/tests/hermes_cli/test_config_exec_names.py
@@ -0,0 +1,29 @@
+"""Case-sensitivity of the subprocess-exec denylist, per platform.
+
+Split out of ``test_config.py`` because the POSIX semantics below only hold
+there; the Windows mixed-case denial stays with the rest of the denylist suite.
+"""
+
+import pytest
+
+from hermes_cli.config import ensure_hermes_home, load_env, save_env_value
+
+
+class TestPosixLowercaseExecNames:
+    """POSIX env names are case-sensitive, so the lowercase spelling of a denied
+    exec-influence name is a different, inert variable. On Windows the same
+    spelling normalizes onto the denylist, which is covered by
+    ``TestEnvWriteDenylist.test_windows_policy_denies_mixed_case_exec_names``.
+    """
+
+    @pytest.fixture(autouse=True)
+    def _hermes_home(self, tmp_path, monkeypatch):
+        monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+        ensure_hermes_home()
+
+    @pytest.mark.parametrize("allowed_key", ["git_config_parameters", "ld_preload"])
+    @pytest.mark.platforms("posix")
+    def test_lowercase_exec_names_are_inert_on_posix(self, allowed_key):
+        save_env_value(allowed_key, "test-value-123")
+        env = load_env()
+        assert env[allowed_key] == "test-value-123"

