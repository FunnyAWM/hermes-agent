diff --git a/apps/desktop/electron/headless-runtime.test.ts b/apps/desktop/electron/headless-runtime.test.ts
new file mode 100644
index 0000000000..5312724c35
--- /dev/null
+++ b/apps/desktop/electron/headless-runtime.test.ts
@@ -0,0 +1,168 @@
+import assert from 'node:assert/strict'
+import fs from 'node:fs'
+import os from 'node:os'
+import path from 'node:path'
+
+import { afterEach, describe, expect, it, vi } from 'vitest'
+
+import {
+  explicitSourceBackend,
+  HEADLESS_RUNTIME_MISSING,
+  headlessRuntime,
+  headlessRuntimeRoot,
+  refuseBootstrap
+} from './headless-runtime'
+import type { InstallStamp } from './install-stamp'
+import type { SourceBackend } from './source-backend'
+
+function stamp(payload: InstallStamp['payload'], localRuntimeRoot?: string): InstallStamp {
+  return {
+    schemaVersion: 1,
+    commit: null,
+    commitDate: null,
+    branch: null,
+    builtAt: null,
+    dirty: false,
+    source: 'local',
+    distribution: 'desktop-app',
+    updateMechanism: payload === 'headless' ? 'external' : 'self',
+    baseVersion: null,
+    displayVersion: null,
+    distance: null,
+    payload,
+    tag: null,
+    ...(localRuntimeRoot === undefined ? {} : { localRuntimeRoot })
+  }
+}
+
+describe('headlessRuntime', () => {
+  it('is only the headless artifact kind', () => {
+    expect(headlessRuntime(null)).toBeNull()
+
+    for (const kind of ['bootstrap', 'bundled', 'light'] as const) {
+      expect(headlessRuntime(stamp(kind))).toBeNull()
+    }
+
+    expect(headlessRuntime(stamp('headless'))).toEqual({ bakedRoot: null })
+  })
+
+  it('resolves the recorded checkout so a double-click runs this machine', () => {
+    const root = path.join(os.tmpdir(), 'hermes-headless-root')
+
+    assert.equal(headlessRuntime(stamp('headless', root))?.bakedRoot, path.resolve(root))
+  })
+
+  it('treats a blank record as no record instead of resolving the cwd', () => {
+    expect(headlessRuntime(stamp('headless', '   '))).toEqual({ bakedRoot: null })
+  })
+
+  it('names the way out when nothing local exists', () => {
+    expect(HEADLESS_RUNTIME_MISSING).toContain('HERMES_DESKTOP_HERMES_ROOT')
+    expect(HEADLESS_RUNTIME_MISSING).toContain('hermes pm install')
+    expect(HEADLESS_RUNTIME_MISSING).not.toContain('bootstrap')
+  })
+})
+
+const tempRoots: string[] = []
+
+function checkout(): string {
+  const root = fs.mkdtempSync(path.join(os.tmpdir(), 'hermes-headless-'))
+  tempRoots.push(root)
+  fs.mkdirSync(path.join(root, 'hermes_cli'))
+  fs.writeFileSync(path.join(root, 'hermes_cli', 'main.py'), '')
+
+  return root
+}
+
+function notACheckout(): string {
+  const root = fs.mkdtempSync(path.join(os.tmpdir(), 'hermes-headless-'))
+  tempRoots.push(root)
+
+  return root
+}
+
+function backendAt(root: string): SourceBackend {
+  return {
+    kind: 'python',
+    label: `Hermes source at ${root}`,
+    command: 'python',
+    args: [],
+    env: {},
+    root,
+    bootstrap: false,
+    shell: false,
+    local: 'installed'
+  }
+}
+
+function rungs(backendFor: (root: string) => Promise<SourceBackend | null> = async (root) => backendAt(root)) {
+  return { backendFor: vi.fn(backendFor), log: vi.fn() }
+}
+
+afterEach(() => {
+  for (const root of tempRoots.splice(0)) {
+    fs.rmSync(root, { force: true, recursive: true })
+  }
+})
+
+describe('explicitSourceBackend', () => {
+  it('honours the env override before the checkout a headless build recorded', async () => {
+    const overrideRoot = checkout()
+    const bakedRoot = checkout()
+    const hooks = rungs()
+
+    const backend = await explicitSourceBackend(stamp('headless', bakedRoot), { HERMES_DESKTOP_HERMES_ROOT: overrideRoot }, hooks)
+
+    expect(backend?.root).toBe(path.resolve(overrideRoot))
+    expect(hooks.backendFor).toHaveBeenCalledTimes(1)
+  })
+
+  it('falls back to the recorded checkout when the override is not a checkout', async () => {
+    const bakedRoot = checkout()
+    const hooks = rungs()
+
+    const backend = await explicitSourceBackend(stamp('headless', bakedRoot), { HERMES_DESKTOP_HERMES_ROOT: notACheckout() }, hooks)
+
+    expect(backend?.root).toBe(path.resolve(bakedRoot))
+  })
+
+  it('only drives a recorded checkout for the headless artifact kind', async () => {
+    const bakedRoot = checkout()
+
+    expect(await explicitSourceBackend(stamp('bootstrap', bakedRoot), {}, rungs())).toBeNull()
+    expect(await explicitSourceBackend(null, {}, rungs())).toBeNull()
+  })
+
+  it('logs and continues down the ladder when the recorded checkout is gone', async () => {
+    const hooks = rungs()
+
+    expect(await explicitSourceBackend(stamp('headless', notACheckout()), {}, hooks)).toBeNull()
+    expect(hooks.log).toHaveBeenCalledWith(expect.stringContaining('not a Hermes checkout'))
+  })
+
+  it('logs and continues when the recorded checkout has no usable Python', async () => {
+    const bakedRoot = checkout()
+    const hooks = rungs(async () => null)
+
+    expect(await explicitSourceBackend(stamp('headless', bakedRoot), {}, hooks)).toBeNull()
+    expect(hooks.log).toHaveBeenCalledWith(expect.stringContaining('no usable Python'))
+  })
+})
+
+describe('refuseBootstrap', () => {
+  it('is a hard stop only for the headless artifact kind', () => {
+    expect(() => refuseBootstrap(null)).not.toThrow()
+    expect(() => refuseBootstrap(stamp('bootstrap'))).not.toThrow()
+    expect(() => refuseBootstrap(stamp('headless'))).toThrow(HEADLESS_RUNTIME_MISSING)
+  })
+})
+
+describe('headlessRuntimeRoot', () => {
+  it('prefers the recorded checkout and falls back only when there is none', () => {
+    expect(headlessRuntimeRoot(stamp('bundled'), () => '/fallback')).toBeNull()
+    expect(headlessRuntimeRoot(stamp('headless', '/recorded/checkout'), () => '/fallback')).toBe(
+      path.resolve('/recorded/checkout')
+    )
+    expect(headlessRuntimeRoot(stamp('headless'), () => '/fallback')).toBe('/fallback')
+  })
+})
diff --git a/apps/desktop/electron/headless-runtime.ts b/apps/desktop/electron/headless-runtime.ts
new file mode 100644
index 0000000000..12284f6016
--- /dev/null
+++ b/apps/desktop/electron/headless-runtime.ts
@@ -0,0 +1,90 @@
+// headless-runtime.ts — the local-runtime contract of the 'headless' artifact.
+//
+// A headless build carries no agent runtime and never installs one: it drives
+// whatever Hermes this machine already has. The builder records the checkout it
+// was made against, so a double-click works on that machine; the explicit
+// HERMES_DESKTOP_HERMES_ROOT override still wins, and every installed-runtime
+// rung of resolveHermesBackend() still applies when the record is stale.
+import path from 'node:path'
+
+import type { InstallStamp } from './install-stamp'
+import { isHermesSourceRoot, type SourceBackend } from './source-backend'
+
+export interface HeadlessRuntime {
+  /** Absolute root recorded at build time, when the stamp carries one. */
+  bakedRoot: string | null
+}
+
+export function headlessRuntime(stamp: Readonly<InstallStamp> | null): HeadlessRuntime | null {
+  if (stamp?.payload !== 'headless') {
+    return null
+  }
+
+  const recorded = stamp.localRuntimeRoot?.trim()
+
+  return { bakedRoot: recorded ? path.resolve(recorded) : null }
+}
+
+/** Shown when a headless artifact finds nothing to drive; it must not bootstrap. */
+export const HEADLESS_RUNTIME_MISSING =
+  'This headless build found no local Hermes runtime, and it never installs one. ' +
+  'Point HERMES_DESKTOP_HERMES_ROOT at a checkout, or install Hermes with `hermes pm install`.'
+
+export interface ExplicitSourceHooks {
+  backendFor: (root: string) => Promise<SourceBackend | null>
+  log: (message: string) => void
+}
+
+/** Rungs 1-1b: the developer override, then the checkout a headless build drove. */
+export async function explicitSourceBackend(
+  stamp: Readonly<InstallStamp> | null,
+  env: NodeJS.ProcessEnv,
+  hooks: ExplicitSourceHooks
+): Promise<SourceBackend | null> {
+  const overrideRoot: string | undefined =
+    env.HERMES_DESKTOP_HERMES_ROOT && path.resolve(env.HERMES_DESKTOP_HERMES_ROOT)
+
+  if (overrideRoot && isHermesSourceRoot(overrideRoot)) {
+    const backend: SourceBackend | null = await hooks.backendFor(overrideRoot)
+
+    if (backend) {
+      return backend
+    }
+  }
+
+  const bakedRoot: string | null = headlessRuntime(stamp)?.bakedRoot ?? null
+
+  if (!bakedRoot) {
+    return null
+  }
+
+  if (isHermesSourceRoot(bakedRoot)) {
+    const backend: SourceBackend | null = await hooks.backendFor(bakedRoot)
+
+    if (backend) {
+      return backend
+    }
+
+    hooks.log(`[boot] headless runtime root ${bakedRoot} has no usable Python; continuing down the ladder`)
+  } else {
+    hooks.log(`[boot] headless runtime root is not a Hermes checkout: ${bakedRoot}; continuing down the ladder`)
+  }
+
+  return null
+}
+
+/** A headless artifact drives this machine's runtime; it must never bootstrap one. */
+export function refuseBootstrap(stamp: Readonly<InstallStamp> | null): void {
+  if (stamp?.payload === 'headless') {
+    throw new Error(HEADLESS_RUNTIME_MISSING)
+  }
+}
+
+/** The runtime root to report for a headless artifact, or null for other kinds. */
+export function headlessRuntimeRoot(stamp: Readonly<InstallStamp> | null, fallback: () => string): string | null {
+  if (stamp?.payload !== 'headless') {
+    return null
+  }
+
+  return headlessRuntime(stamp)?.bakedRoot ?? fallback()
+}
