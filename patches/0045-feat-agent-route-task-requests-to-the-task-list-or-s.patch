From d1600733bc202b720531d25b3deb1f9cf97ff3ff Mon Sep 17 00:00:00 2001
From: FunnyAWM <1142978300@qq.com>
Date: Fri, 6 Nov 2026 16:31:55 +0800
Subject: [PATCH] feat(agent): route task requests to the task list or
 scheduled jobs

One assistant now owns both tools, so the prompt states the split: a
request to record or track work goes to todo_list, a request that names a
time or recurrence goes to cronjob_manage. The block only appears when
both tools are actually enabled, so no surface advertises a tool it
lacks.
---
 agent/prompt_builder.py                | 10 ++++++++++
 agent/system_prompt.py                 |  5 ++++-
 tests/agent/test_system_prompt_root.py |  9 +++++++++
 3 files changed, 23 insertions(+), 1 deletion(-)

diff --git a/agent/prompt_builder.py b/agent/prompt_builder.py
index eb8de4439c..11d29e7c74 100644
--- a/agent/prompt_builder.py
+++ b/agent/prompt_builder.py
@@ -392,6 +392,16 @@ TASK_COMPLETION_GUIDANCE = (
     "produce. Reporting a blocker honestly is always better than inventing a result."
 )
 
+# Task routing (desktop Bot Mode): one assistant owns both the session task list and scheduled
+# jobs, so it must pick by what the user asked for rather than defaulting to either tool.
+TASK_ROUTING_GUIDANCE = (
+    "# Task routing\n"
+    "When the user asks you to record, track or assign something to do, put it in the session task "
+    "list with todo_list. When the user names a time, a recurrence or a reminder, create a scheduled "
+    "job with cronjob_manage. Do not turn a plain request into a scheduled job, and claim something "
+    "is scheduled only after the job was created."
+)
+
 # Universal parallel-tool-call guidance (ALL models): the runtime already executes independent calls
 # concurrently. Supersedes the former Google-only bullet so no model receives the steer twice.
 # Why this matters for cost: every assistant turn resends the entire accumulated conversation (and, on
diff --git a/agent/system_prompt.py b/agent/system_prompt.py
index 1ce5b00828..09e9bca957 100644
--- a/agent/system_prompt.py
+++ b/agent/system_prompt.py
@@ -22,7 +22,8 @@ from agent.prompt_builder import (
     DEFAULT_AGENT_IDENTITY, EXECUTION_GUIDANCE_MODELS, GOOGLE_MODEL_OPERATIONAL_GUIDANCE,
     HERMES_AGENT_HELP_GUIDANCE, HERMES_AGENT_HELP_GUIDANCE_NO_SKILLS, KANBAN_GUIDANCE,
     PARALLEL_TOOL_CALL_GUIDANCE, PLATFORM_HINTS, SESSION_SEARCH_GUIDANCE,
-    SKILLS_GUIDANCE, STEER_CHANNEL_NOTE, TASK_COMPLETION_GUIDANCE, TELEGRAM_RICH_MESSAGES_HINT,
+    SKILLS_GUIDANCE, STEER_CHANNEL_NOTE, TASK_COMPLETION_GUIDANCE, TASK_ROUTING_GUIDANCE,
+    TELEGRAM_RICH_MESSAGES_HINT,
     TOOL_USE_ENFORCEMENT_GUIDANCE, TOOL_USE_ENFORCEMENT_MODELS, drain_truncation_warnings,
 )
 from agent import prompt_builder as _pb
@@ -608,6 +609,8 @@ def _guidance_parts(agent: Any) -> list[str]:
     parts.append(_tool_guidance_block(agent))  # None/empty entries are dropped by _join_tier
     if not agent.valid_tool_names:
         return parts
+    if {"todo_list", "cronjob_manage"} <= set(agent.valid_tool_names):
+        parts.append(TASK_ROUTING_GUIDANCE)
     # Steering only lands inside tool results, so only reachable with tools; a one-shot has nobody to steer it.
     from agent.oneshot_footprint import agent_is_oneshot
     if not agent_is_oneshot(agent):
diff --git a/tests/agent/test_system_prompt_root.py b/tests/agent/test_system_prompt_root.py
index 9cfd3ac5d5..702f0650e2 100644
--- a/tests/agent/test_system_prompt_root.py
+++ b/tests/agent/test_system_prompt_root.py
@@ -57,6 +57,15 @@ def test_memory_order_is_memory_user_notes_after_root(tmp_path, monkeypatch):
     assert full.index(MEMORY_ROOT_PROMPT) < full.index("MEMORY_MARKER") < full.index("USER_MARKER") < full.index("NOTES INDEX")
 
 
+def test_task_routing_guidance_needs_both_task_tools():
+    both = build_system_prompt_parts(_agent(valid_tool_names=["todo_list", "cronjob_manage"]))["stable"]
+    assert "session task list" in both
+    assert "cronjob_manage" in both
+
+    only_tasks = build_system_prompt_parts(_agent(valid_tool_names=["todo_list"]))["stable"]
+    assert "session task list" not in only_tasks
+
+
 def test_stable_prefix_is_byte_stable_across_calls():
     agent = _agent(load_soul_identity=False, skip_context_files=True)
     first = build_system_prompt(agent)

