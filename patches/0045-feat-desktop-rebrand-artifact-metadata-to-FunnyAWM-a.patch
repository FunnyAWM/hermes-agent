From 0d1be39e66fe111bc2db59510827bde4c635e32e Mon Sep 17 00:00:00 2001
From: FunnyAWM <1142978300@qq.com>
Date: Fri, 6 Nov 2026 17:03:00 +0800
Subject: [PATCH 45/48] feat(desktop): rebrand artifact metadata to FunnyAWM
 and Rosmontis

Windows artifacts now carry FunnyAWM as company/copyright, the npm
author carries the new contact email, and the installer file
description names Rosmontis instead of Hermes Agent. Also fixes the
rowPreview parameter type caught by the typecheck.
---
 apps/bootstrap-installer/src-tauri/tauri.conf.json | 4 ++--
 apps/desktop/electron-builder.config.cjs           | 9 +++++----
 apps/desktop/electron/main.ts                      | 4 ++--
 apps/desktop/package.json                          | 7 +++++--
 apps/desktop/scripts/set-exe-identity.mjs          | 6 +++---
 apps/desktop/src/plugins/hermes-bots/bot-row.tsx   | 2 +-
 6 files changed, 18 insertions(+), 14 deletions(-)

diff --git a/apps/bootstrap-installer/src-tauri/tauri.conf.json b/apps/bootstrap-installer/src-tauri/tauri.conf.json
index a82b4ca703..91953352b6 100644
--- a/apps/bootstrap-installer/src-tauri/tauri.conf.json
+++ b/apps/bootstrap-installer/src-tauri/tauri.conf.json
@@ -36,8 +36,8 @@
     "category": "DeveloperTool",
     "shortDescription": "Hermes",
     "longDescription": "Installs Hermes Agent on your machine. Drives scripts/install.ps1 (Windows) and scripts/install.sh (macOS/Linux).",
-    "publisher": "Nous Research",
-    "copyright": "Copyright © 2026 Nous Research",
+    "publisher": "FunnyAWM",
+    "copyright": "Copyright © 2026 FunnyAWM",
     "targets": [
       "app",
       "dmg",
diff --git a/apps/desktop/electron-builder.config.cjs b/apps/desktop/electron-builder.config.cjs
index 532830508b..5acabea2d4 100644
--- a/apps/desktop/electron-builder.config.cjs
+++ b/apps/desktop/electron-builder.config.cjs
@@ -74,6 +74,9 @@ module.exports = {
   electronVersion,
   appId,
   productName: displayName,
+  // Stamped into every Windows artifact's LegalCopyright; package.json's
+  // `author` still supplies CompanyName.
+  copyright: 'Copyright © 2026 FunnyAWM',
   executableName: displayName,
   protocols: [
     {
@@ -280,10 +283,8 @@ module.exports = {
   },
   linux: {
     category: 'Development',
-    maintainer: 'Nous Research <support@nousresearch.com>',
-    synopsis: light
-      ? 'Remote-only desktop client for Hermes Agent.'
-      : 'Native desktop shell for Hermes Agent.',
+    maintainer: 'FunnyAWM <funnyawm@qq.com>',
+    synopsis: 'Rosmontis',
     target: ['AppImage']
   }
 }
diff --git a/apps/desktop/electron/main.ts b/apps/desktop/electron/main.ts
index c30edae116..bc70c9d121 100644
--- a/apps/desktop/electron/main.ts
+++ b/apps/desktop/electron/main.ts
@@ -1818,7 +1818,7 @@ if (IS_WINDOWS) {
 app.setAboutPanelOptions({
   applicationName: APP_NAME,
   applicationVersion: nativeAboutVersion(appVersionInfo(INSTALL_STAMP, '', app.getVersion())),
-  copyright: 'Copyright © 2026 Nous Research'
+  copyright: 'Copyright © 2026 FunnyAWM'
 })
 
 // Custom scheme for streaming audio/video into the renderer. Local paths read
@@ -17138,7 +17138,7 @@ function showAboutPanelFresh(): void {
     app.setAboutPanelOptions({
       applicationName: APP_NAME,
       applicationVersion: skew.outOfSync ? `${display} — app build out of date, update the desktop app` : display,
-      copyright: 'Copyright © 2026 Nous Research'
+      copyright: 'Copyright © 2026 FunnyAWM'
     })
     app.showAboutPanel()
   })
diff --git a/apps/desktop/package.json b/apps/desktop/package.json
index 02c9cc08ca..bd05f1e9be 100644
--- a/apps/desktop/package.json
+++ b/apps/desktop/package.json
@@ -3,8 +3,11 @@
   "productName": "KouriChat Next",
   "private": true,
   "version": "0.22.5-fork.1",
-  "description": "Native desktop shell for Hermes Agent.",
-  "author": "Nous Research",
+  "description": "Native desktop shell for Rosmontis.",
+  "author": {
+    "name": "FunnyAWM",
+    "email": "funnyawm@qq.com"
+  },
   "repository": {
     "type": "git",
     "url": "git+https://github.com/NousResearch/hermes-agent.git"
diff --git a/apps/desktop/scripts/set-exe-identity.mjs b/apps/desktop/scripts/set-exe-identity.mjs
index d103c6ba87..f112cc168d 100644
--- a/apps/desktop/scripts/set-exe-identity.mjs
+++ b/apps/desktop/scripts/set-exe-identity.mjs
@@ -87,9 +87,9 @@ async function stampExeIdentity(
     icon,
     'version-string': {
       ProductName: 'Hermes',
-      FileDescription: 'Hermes',
-      CompanyName: 'Nous Research',
-      LegalCopyright: 'Copyright (c) 2026 Nous Research'
+      FileDescription: 'Rosmontis',
+      CompanyName: 'FunnyAWM',
+      LegalCopyright: 'Copyright (c) 2026 FunnyAWM'
     }
   }
 
diff --git a/apps/desktop/src/plugins/hermes-bots/bot-row.tsx b/apps/desktop/src/plugins/hermes-bots/bot-row.tsx
index e82f70fd28..07a7c91466 100644
--- a/apps/desktop/src/plugins/hermes-bots/bot-row.tsx
+++ b/apps/desktop/src/plugins/hermes-bots/bot-row.tsx
@@ -98,7 +98,7 @@ import {
  *  an age is spelled. Not `relativeTime` — that's the bidirectional Intl form
  *  ("in 14 hr"), which belongs on a scheduled next-run. */
 /** The one-line preview under a row: a bot-to-bot delivery drops its prefix. */
-function rowPreview(preview: string | undefined | null, fromBot: boolean): string {
+function rowPreview(preview: string | undefined | null, fromBot: string | null): string {
   if (fromBot) {
     return (preview || '').replace(A2A_PREFIX_RE, '').trim() || '…'
   }
