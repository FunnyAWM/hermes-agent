@@ -0,0 +1,52 @@
+import assert from 'node:assert/strict'
+import path from 'node:path'
+
+import { test, vi } from 'vitest'
+
+import { stopGatewayForQuit } from './gateway-quit'
+
+const HERMES = process.platform === 'win32' ? path.join('Scripts', 'hermes.exe') : path.join('bin', 'hermes')
+
+test('quit requests a detached gateway stop without waiting', () => {
+  const unref = vi.fn()
+  const spawn = vi.fn(() => ({ unref }))
+  const log = vi.fn()
+  const cli = path.join('C:\\source', '.venv', HERMES)
+
+  stopGatewayForQuit(['C:\\missing', 'C:\\source'], 'C:\\home', log, {
+    existsSync: candidate => candidate === cli,
+    spawn: spawn as never
+  })
+
+  assert.equal(spawn.mock.calls[0][0], cli)
+  assert.deepEqual(spawn.mock.calls[0][1], ['gateway', 'stop', '-y'])
+  assert.equal((spawn.mock.calls[0][2] as { detached: boolean }).detached, true)
+  assert.equal((spawn.mock.calls[0][2] as { env: NodeJS.ProcessEnv }).env.HERMES_HOME, 'C:\\home')
+  assert.equal(unref.mock.calls.length, 1)
+  assert.match(log.mock.calls[0][0], /stop requested/)
+})
+
+test('a missing CLI skips the stop and says why', () => {
+  const spawn = vi.fn()
+  const log = vi.fn()
+
+  stopGatewayForQuit(['C:\\missing'], 'C:\\home', log, { existsSync: () => false, spawn: spawn as never })
+
+  assert.equal(spawn.mock.calls.length, 0)
+  assert.match(log.mock.calls[0][0], /no managed hermes CLI/)
+})
+
+test('a spawn failure is logged, never thrown', () => {
+  const log = vi.fn()
+  const cli = path.join('C:\\source', 'venv', HERMES)
+
+  assert.doesNotThrow(() =>
+    stopGatewayForQuit(['C:\\source'], 'C:\\home', log, {
+      existsSync: candidate => candidate === cli,
+      spawn: () => {
+        throw new Error('spawn denied')
+      }
+    })
+  )
+  assert.match(log.mock.calls[0][0], /spawn denied/)
+})
diff --git a/apps/desktop/electron/gateway-quit.ts b/apps/desktop/electron/gateway-quit.ts
new file mode 100644
index 0000000000..b7b19b2128
--- /dev/null
+++ b/apps/desktop/electron/gateway-quit.ts
@@ -0,0 +1,53 @@
+import { spawn } from 'node:child_process'
+import { existsSync } from 'node:fs'
+import path from 'node:path'
+
+interface ChildLike {
+  unref: () => void
+}
+
+export interface GatewayQuitStopDeps {
+  existsSync?: (path: string) => boolean
+  spawn?: (command: string, args: string[], options: object) => ChildLike
+}
+
+/**
+ * Stop the local gateway owner when Desktop really quits. Detached so quit never
+ * waits on the gateway's drain; hiding to the tray never reaches this path.
+ * Roots are tried in order (headless baked checkout first, then the update root).
+ */
+export function stopGatewayForQuit(
+  roots: readonly (string | null | undefined)[],
+  home: string,
+  log: (message: string) => void,
+  deps: GatewayQuitStopDeps = {}
+): void {
+  const exists = deps.existsSync ?? existsSync
+  const run = deps.spawn ?? spawn
+  const bin = process.platform === 'win32' ? path.join('Scripts', 'hermes.exe') : path.join('bin', 'hermes')
+
+  const cliPath = roots
+    .filter((root): root is string => Boolean(root))
+    .flatMap(root => [path.join(root, 'venv', bin), path.join(root, '.venv', bin)])
+    .find(exists)
+
+  if (!cliPath) {
+    log('[gateway] stop on quit skipped: no managed hermes CLI under the runtime roots')
+
+    return
+  }
+
+  try {
+    const child = run(cliPath, ['gateway', 'stop', '-y'], {
+      env: { ...process.env, HERMES_HOME: home },
+      detached: true,
+      stdio: 'ignore',
+      windowsHide: true
+    })
+
+    child.unref()
+    log(`[gateway] stop requested for desktop quit via ${cliPath}`)
+  } catch (error) {
+    log(`[gateway] stop on quit failed: ${error instanceof Error ? error.message : String(error)}`)
+  }
+}
